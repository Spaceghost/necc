-- Compile C to x86-64 System V assembly for the standalone Nelibc SDK.
## pragmas.nogc = true

require 'smallalloc'
require 'arg'
local driver = require 'driver'
local elf = require 'elfobject'
local headers = require 'headers'
local ct = require 'ctypes'
local fp = require 'floating'
local leaf = require 'leaf'
local smallinline = require 'smallinline'
local affine = require 'affine'
local sse = require 'sse'
local ce = require 'consteval'
require 'hashmap'
require 'io'
require 'os'
require 'sequence'
require 'string'
require 'stringbuilder'
require 'memory'

local header_roots: *sequence(string)
local source: string
local source_path: string
local offset: isize = 1
local line: integer = 1
local token_line: integer = 1
local token: string
local optimize_memcpy: boolean
local qualified_storage: boolean
local Kind, Id = ct.Kind, ct.Id
local aliases: headers.Aliases
local enumerators: ce.Names
local inside_header: boolean
local sdk = os.getenv('NECC_SYSROOT')
if #sdk == 0 then sdk = '/usr/lib/necc' end
local Variable = @record{slot: integer, kind: Id, level: integer, symbol: string,
                         readonly: boolean, internal: boolean, defined: boolean, tentative: boolean, indirect: boolean}
local Binding = @record{name: string, previous: Variable}
local bindings: sequence(Binding)
local variables: hashmap(string, Variable)
local locals: hashmap(string, Variable)
local functions: hashmap(string, ct.Signature)
local data: sequence(string)
local rodata: sequence(string)
local constants: sequence(string)
local scope: integer = 1
local function_result: Id
local active_ret: string
local statement_expression_depth: integer
local function_ms: boolean
local indirect_result_slot: integer
local calls_sysv: boolean
local uses_string_copy: boolean
local break_to: string
local continue_to: string
local assembly: sequence(string)
local body: sequence(string)
local counted_loop: boolean
local slots: integer
local depth: integer
local label_count: integer
local wide_registers: []string = {'%rdi', '%rsi', '%rdx', '%rcx', '%r8', '%r9'}

local ms_registers: []string = {'%rcx','%rdx','%r8','%r9'}
local function argument_register(ms: boolean, reg: integer): string
  return ms and ms_registers[reg-1] or wide_registers[reg-1]
end

local function fail(message: string): void <noreturn>
  io.stderr:write('necc: ' .. source_path .. ':' .. tostring(token_line) .. ': ' .. message .. '\n')
  driver.finish(1)
end

local function source_byte(position: isize): byte
  if position < 1 or position > (@isize)(#source) then return 0 end
  return source.data[position-1]
end

local function letter(c: byte): boolean
  return (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95
end

local function digit(c: byte): boolean
  return c >= 48 and c <= 57
end

local sdk_prefix=sdk .. '/'
local function horizontal(c: byte): boolean
  return c==32 or (c>=9 and c<=13)
end

local function preprocessor_line()
  local first=offset
  local stop=(@isize)(#source)+1
  local newline=memory.scan(&source.data[first-1],10,(@usize)(stop-first))
  if newline~=nilptr then stop=(@isize)(newline)-(@isize)(source.data)+1 end
  offset=stop+1
  local i=first+1
  while i<stop and horizontal(source.data[i-1]) do i=i+1 end
  if i>=stop or not digit(source.data[i-1]) then
    if source:subview(first,first+6)~='#pragma' then fail('expected a preprocessed C line marker') end
    line=line+1
    return
  end
  local nextline: integer=0
  while i<stop and digit(source.data[i-1]) do
    local d=source.data[i-1]-48
    if nextline>(9223372036854775807-d)//10 then fail('line marker exceeds integer range') end
    nextline=nextline*10+d; i=i+1
  end
  if i>=stop or not horizontal(source.data[i-1]) then fail('expected a preprocessed C line marker') end
  while i<stop and horizontal(source.data[i-1]) do i=i+1 end
  local last=stop-1
  while last>i and source.data[last-1]~=34 do last=last-1 end
  if i>=last or source.data[i-1]~=34 then fail('expected a preprocessed C line marker') end
  line=nextline
  source_path=source:subview(i+1,last-1)
  inside_header=source_path:subview(1,#sdk_prefix)==sdk_prefix
  if inside_header then
    local relative=source_path:subview(#sdk_prefix+1)
    inside_header=relative:subview(1,8)=='include/' or relative:subview(1,12)=='tcc/include/' or relative:subview(1,5)=='uapi/'
  end
  if not inside_header and source_path:subview(-2)=='.h' then
    for k: usize=1,#($header_roots) do
      local root=($header_roots)[k]
      if source_path:subview(1,#root)==root and
          (root:subview(-1)=='/' or source_path:subview(#root+1,#root+1)=='/') then
        inside_header=true; break
      end
    end
  end
end

local function next_token()
  while offset <= (@isize)(#source) do
    local c = source_byte(offset)
    if c == 35 then
      preprocessor_line()
    elseif c == 32 or (c >= 9 and c <= 13) then
      if c == 10 then line = line + 1 end
      offset = offset + 1
    elseif c == 47 and source_byte(offset + 1) == 47 then
      repeat offset = offset + 1 until source_byte(offset) == 0 or source_byte(offset) == 10
    elseif c == 47 and source_byte(offset + 1) == 42 then
      token_line = line
      offset = offset + 2
      while source_byte(offset) ~= 42 or source_byte(offset + 1) ~= 47 do
        if source_byte(offset) == 0 then fail('unterminated comment') end
        if source_byte(offset) == 10 then line = line + 1 end
        offset = offset + 1
      end
      offset = offset + 2
    else
      break
    end
  end
  token_line = line
  if offset > (@isize)(#source) then
    token = ''
    return
  end
  local first = offset
  local c = source_byte(offset)
  offset = offset + 1
  if c == 34 or c == 39 then
    while source_byte(offset) ~= c do
      if source_byte(offset) == 92 then offset = offset + 1 end
      if source_byte(offset) == 0 or source_byte(offset) == 10 then fail('unterminated literal') end
      offset = offset + 1
    end
    offset = offset + 1
  elseif digit(c) or (c == 46 and digit(source_byte(offset))) then
    while true do
      local ch=source_byte(offset)
      local prev=source_byte(offset-1)
      if letter(ch) or digit(ch) or ch == 46 or
          ((ch == 43 or ch == 45) and (prev == 69 or prev == 101 or prev == 80 or prev == 112)) then
        offset=offset+1
      else break end
    end
  elseif letter(c) then
    while letter(source_byte(offset)) or digit(source_byte(offset)) do offset=offset+1 end
  else
    local three = source:subview(first,first+2)
    local two = source:subview(first,first+1)
    if three == '...' or three == '<<=' or three == '>>=' then offset = first+3
    elseif two == '->' or two == '++' or two == '--' or two == '&&' or two == '||' or
        two == '<<' or two == '>>' or two == '==' or two == '!=' or two == '<=' or two == '>=' or
        two == '+=' or two == '-=' or two == '*=' or two == '/=' or two == '%=' or
        two == '&=' or two == '|=' or two == '^=' then
      offset = first+2
    end
  end
  token = source:subview(first, offset - 1)
  -- Declaration parsing strips qualifiers. Preserve memory access for
  -- volatile or atomic storage, including through previously seen typedefs.
  if token=='volatile' or token=='_Atomic' or token=='__volatile' or token=='__volatile__' then qualified_storage=true end
end

local function take(expected: string): boolean
  if token ~= expected then return false end
  next_token()
  return true
end

local function expect(expected: string)
  if not take(expected) then fail("expected '" .. expected .. "', got '" .. token .. "'") end
end

local keywords: []string = {
  'auto', 'break', 'case', 'char', 'const', 'continue', 'default', 'do',
  'double', 'else', 'enum', 'extern', 'float', 'for', 'goto', 'if', 'inline',
  'int', 'long', 'register', 'restrict', 'return', 'short', 'signed', 'sizeof',
  'static', 'struct', 'switch', 'typedef', 'union', 'unsigned', 'void',
  'volatile', 'while', '_Alignas', '_Alignof', '_Atomic', '_Bool',
  '_Complex', '_Generic', '_Imaginary', '_Noreturn', '_Static_assert', '_Thread_local'
}

local function allowed_name(name: string): boolean
  if #name == 0 or not letter(name:byte(1)) then return false end
  for index: usize = 0, #keywords - 1 do
    if name == keywords[index] then return false end
  end
  return true
end

local function identifier(): string
  if not allowed_name(token) then fail('expected identifier') end
  local name = token
  next_token()
  return name
end

local function emit(instruction: string)
  body:push('  ' .. instruction)
end

local function label(): string
  label_count = label_count+1
  return '.Lnecc_' .. tostring(label_count)
end

local function address(slot: integer): string
  return tostring(-slot) .. '(%rbp)'
end

local function bind_local(name: string, v: Variable): Variable
  if locals[name].level == scope then fail('duplicate local ' .. name) end
  bindings:push({name=name,previous=locals[name]})
  v.level=scope
  locals[name]=v
  return v
end

local function reserve(k: Id): integer
  local size,alignment=ct.size(k),ct.align(k)
  if not ct.is_complete(k) or alignment <= 0 then fail('incomplete object type') end
  if size == 0 and ct.is_record(k) then size=1 end -- GNU empty records still need an addressable scratch byte.
  if size <= 0 then fail('incomplete object type') end
  if alignment < 8 then alignment=8 end
  slots=((slots+size+alignment-1)//alignment)*alignment
  return slots
end

-- Windows x64 requires a caller-owned, 16-byte aligned copy for an
-- aggregate whose size is not 1, 2, 4 or 8 bytes.
local function ms_indirect(k: Id): boolean
  if not ct.is_record(k) then return false end
  local n = ct.size(k)
  return n ~= 1 and n ~= 2 and n ~= 4 and n ~= 8
end
local function aggregate_temporary(k: Id): integer
  reserve(k)
  slots = ((slots+15)//16)*16
  return slots
end

local function allocate(name: string,k: Id,readonly: boolean): Variable
  return bind_local(name,{slot=reserve(k),kind=k,readonly=readonly})
end

local function leave_scope(mark: usize)
  while #bindings > mark do
    local saved = bindings:pop()
    locals[saved.name] = saved.previous
  end
end

local function push_result()
  emit('pushq %rax'); depth = depth+1
end

local function pop_result(reg: string)
  emit('popq ' .. reg); depth = depth-1
end

local function normalize(k: Id)
  if k == Kind.Char or k == Kind.SChar then emit('movsbq %al, %rax')
  elseif k == Kind.Bool or k == Kind.UChar then emit('movzbl %al, %eax')
  elseif k == Kind.Short then emit('movswq %ax, %rax')
  elseif k == Kind.UShort then emit('movzwl %ax, %eax')
  elseif k == Kind.Int then emit('movslq %eax, %rax')
  elseif k == Kind.UInt then emit('movl %eax, %eax') end
end

local function load_memory(k: Id, place: string)
  local n = ct.size(k)
  if ct.long_double(k) then emit('leaq ' .. place .. ', %rax'); return end
  if n == 1 then emit((ct.unsigned(k) and 'movzbq ' or 'movsbq ') .. place .. ', %rax')
  elseif n == 2 then emit((ct.unsigned(k) and 'movzwq ' or 'movswq ') .. place .. ', %rax')
  elseif n == 4 then emit((ct.unsigned(k) and 'movl ' or 'movslq ') .. place .. (ct.unsigned(k) and ', %eax' or ', %rax'))
  elseif n == 8 then emit('movq ' .. place .. ', %rax')
  else fail('unsupported scalar load') end
end

local function store_memory(k: Id, place: string)
  local n = ct.size(k)
  if ct.long_double(k) then
    emit('movq %rax, %r11'); emit('movq (%r11), %r10'); emit('movq 8(%r11), %r11')
    emit('leaq ' .. place .. ', %rdi'); emit('movq %r10, (%rdi)'); emit('movq %r11, 8(%rdi)')
  elseif n == 1 then emit('movb %al, ' .. place)
  elseif n == 2 then emit('movw %ax, ' .. place)
  elseif n == 4 then emit('movl %eax, ' .. place)
  elseif n == 8 then emit('movq %rax, ' .. place)
  else fail('unsupported scalar store') end
end

local function immediate(n: integer)
  if n >= 0 and n <= 4294967295 then emit('movl $' .. tostring(n) .. ', %eax')
  else emit('movq $' .. tostring(n) .. ', %rax') end
end

local function read_type(): Id
  local words: headers.Tokens
  local nest: integer = 0
  while #token > 0 and (token ~= ')' or nest > 0) do
    if token == '(' then nest = nest+1 elseif token == ')' then nest = nest-1 end
    words:push(token); next_token()
  end
  expect(')')
  local d = headers.parse(&words,&aliases,&enumerators)
  words:destroy()
  if d.kind == Kind.Unknown or #d.name ~= 0 then fail('invalid type name') end
  return d.kind
end

local function literal_bytes(s: string, bytes: *sequence(byte))
  local diagnostic=ce.bytes(s,bytes)
  if #diagnostic > 0 then fail(diagnostic) end
end

local function strings(): sequence(byte)
  local bytes: sequence(byte)
  repeat literal_bytes(token,&bytes); next_token() until #token == 0 or token:byte(1) ~= 34
  bytes:push(0)
  return bytes
end

local function string_symbol(bytes: *sequence(byte)): string
  local name = label()
  constants:push(name .. ':')
  for i: usize = 1, #($bytes) do constants:push('  .byte ' .. tostring(($bytes)[i])) end
  return name
end

local function long_double_symbol(word: string): string
  local significand,sign_exponent,k=fp.literal_long_double(word)
  if k == Kind.Unknown then fail('invalid long double literal') end
  local name=label()
  constants:push(name .. ':')
  constants:push('  .quad ' .. tostring(significand))
  constants:push('  .short ' .. tostring(sign_exponent))
  for i=1,6 do constants:push('  .byte 0') end
  return name
end

local Expr = @record{kind: Id, lvalue: boolean, readonly: boolean, null_constant: boolean, symbol: string,
                     place: string, mark: usize, literal: boolean, number: integer, cc: string}
local function scalar(k: Id): boolean return ct.is_integer(k) or ct.is_pointer(k) or ct.floating(k) or ct.long_double(k) end

-- An lvalue leaves its address in RAX. Load only when the context needs its value.
local function value(e: Expr): Expr
  if ct.is_function(e.kind) then
    if #e.symbol > 0 then emit('leaq ' .. e.symbol .. '(%rip), %rax') end
    return {kind=ct.pointer(e.kind)}
  elseif ct.is_array(e.kind) then
    return {kind=ct.pointer(ct.element(e.kind))}
  elseif e.lvalue then
    if ct.is_record(e.kind) then return {kind=e.kind} end
    if ct.long_double(e.kind) then return {kind=e.kind} end -- RAX remains the 16-byte value address.
    if not scalar(e.kind) then fail('unsupported object value') end
    if #e.place>0 and #body==e.mark then
      body:pop()
      load_memory(e.kind,e.place)
      return {kind=e.kind,place=e.place,mark=#body}
    end
    load_memory(e.kind,'(%rax)')
    return {kind=e.kind}
  end
  return e
end

local function compatible_pointer(a: Id,b: Id): boolean
  if a == b then return true end
  local x,y = ct.element(a),ct.element(b)
  return (x == Kind.Void and not ct.is_function(y)) or (y == Kind.Void and not ct.is_function(x))
end

local function xmm_in(k: Id,reg: string)
  emit((k == Kind.Float and 'movd %eax, ' or 'movq %rax, ') .. reg)
end
local function xmm_out(k: Id,reg: string)
  emit((k == Kind.Float and 'movd ' or 'movq ') .. reg .. (k == Kind.Float and ', %eax' or ', %rax'))
end

local function truth(k: Id)
  if ct.floating(k) then
    xmm_in(k,'%xmm0'); emit('pxor %xmm1, %xmm1')
    emit(sse.compare(k, 1, 0))
    emit('setne %al'); emit('setp %dl'); emit('orb %dl, %al'); emit('movzbl %al, %eax')
  elseif ct.long_double(k) then
    emit('fldt (%rax)'); emit('ftst'); emit('fnstsw %ax'); emit('fstp %st(0)'); emit('sahf')
    emit('setne %al'); emit('setp %dl'); emit('orb %dl, %al'); emit('movzbl %al, %eax')
  else emit('testq %rax, %rax'); emit('setne %al'); emit('movzbl %al, %eax') end
end

local function numeric_conversion(from: Id,into: Id)
  if from == into then return end
  if into == Kind.LongDouble then
    local source=reserve(ct.is_integer(from) and Kind.Long or from)
    if ct.long_double(from) then emit('fldt (%rax)')
    elseif ct.floating(from) then
      store_memory(from,address(source)); emit(from == Kind.Float and 'flds ' .. address(source) or 'fldl ' .. address(source))
    elseif ct.is_integer(from) then
      if ct.unsigned(from) and ct.size(from)==8 then
        local low,done=label(),label()
        emit('testq %rax, %rax'); emit('jns ' .. low)
        local two64=reserve(Kind.Double)
        emit('movq %rax, ' .. address(source)); emit('fildq ' .. address(source))
        immediate(0x43f0000000000000); emit('movq %rax, ' .. address(two64)); emit('fldl ' .. address(two64))
        emit('faddp %st, %st(1)'); emit('jmp ' .. done)
        emit(low .. ':'); emit('movq %rax, ' .. address(source)); emit('fildq ' .. address(source)); emit(done .. ':')
      else
        normalize(from); emit('movq %rax, ' .. address(source)); emit('fildq ' .. address(source))
      end
    else fail('unsupported conversion to long double') end
    local result=reserve(Kind.LongDouble); emit('fstpt ' .. address(result)); emit('leaq ' .. address(result) .. ', %rax')
    return
  elseif from == Kind.LongDouble then
    if into == Kind.Float or into == Kind.Double then
      local result=reserve(into)
      emit('fldt (%rax)')
      emit(into == Kind.Float and 'fstps ' .. address(result) or 'fstpl ' .. address(result))
      load_memory(into,address(result)); return
    elseif ct.is_integer(into) then
      emit('movq %rax, %r11')
      local result=reserve(Kind.Long); local control=reserve(Kind.UShort); local truncation=reserve(Kind.UShort)
      emit('fnstcw ' .. address(control)); emit('movzwl ' .. address(control) .. ', %eax')
      emit('orl $0x0c00, %eax'); emit('movw %ax, ' .. address(truncation)); emit('fldcw ' .. address(truncation))
      if ct.unsigned(into) and ct.size(into)==8 then
        local threshold=reserve(Kind.Double); local low,done=label(),label()
        immediate(0x43e0000000000000); emit('movq %rax, ' .. address(threshold))
        emit('fldl ' .. address(threshold)); emit('fldt (%r11)'); emit('fucomip %st(1), %st'); emit('fstp %st(0)')
        emit('jb ' .. low)
        emit('fldl ' .. address(threshold)); emit('fldt (%r11)'); emit('fsubp %st, %st(1)')
        emit('fistpq ' .. address(result)); emit('btsq $63, ' .. address(result)); emit('jmp ' .. done)
        emit(low .. ':'); emit('fldt (%r11)'); emit('fistpq ' .. address(result)); emit(done .. ':')
      else emit('fldt (%r11)'); emit('fistpq ' .. address(result)) end
      emit('fldcw ' .. address(control))
      load_memory(into,address(result)); normalize(into); return
    end
  end
  if ct.floating(into) then
    if ct.floating(from) then
      xmm_in(from,'%xmm0'); emit(sse.convert(from, into))
    elseif ct.unsigned(from) and ct.size(from) == 8 then
      local low,done=label(),label()
      emit('testq %rax, %rax'); emit('jns ' .. low)
      emit('movq %rax, %rdx'); emit('andl $1, %edx'); emit('shrq $1, %rax'); emit('orq %rdx, %rax')
      emit(sse.convert(Kind.Long, into)); emit(sse.arithmetic(into, 'add', 0, 0))
      emit('jmp ' .. done); emit(low .. ':'); emit(sse.convert(Kind.Long, into)); emit(done .. ':')
    else emit(sse.convert(Kind.Long, into)) end
    xmm_out(into,'%xmm0')
  elseif ct.floating(from) then
    xmm_in(from,'%xmm0')
    if ct.unsigned(into) and ct.size(into) == 8 then
      if from == Kind.Float then emit(sse.convert(Kind.Float, Kind.Double)) end
      local low,done=label(),label()
      immediate(0x43e0000000000000); emit('movq %rax, %xmm1') -- 2^63
      emit(sse.compare(Kind.Double, 1, 0)); emit('jb ' .. low)
      emit(sse.arithmetic(Kind.Double, 'sub', 1, 0)); emit(sse.convert(Kind.Double, Kind.Long)); emit('btcq $63, %rax')
      emit('jmp ' .. done); emit(low .. ':'); emit(sse.convert(Kind.Double, Kind.Long)); emit(done .. ':')
    else emit(sse.convert(from, Kind.Long)) end
    normalize(into)
  else normalize(into) end
end

local function convert(e: Expr,k: Id,cast: boolean): Expr
  e=value(e)
  if k == Kind.Void and cast then return {kind=k} end
  if not scalar(e.kind) or not scalar(k) then fail('unsupported scalar conversion') end
  if k == Kind.Bool then truth(e.kind)
  elseif ct.is_pointer(k) then
    if ct.floating(e.kind) or ct.long_double(e.kind) or (not cast and not e.null_constant and
        (not ct.is_pointer(e.kind) or not compatible_pointer(k,e.kind))) then fail('incompatible pointer conversion') end
  elseif ct.is_pointer(e.kind) then
    if not cast or ct.floating(k) or ct.long_double(k) then fail('incompatible pointer conversion') end
    normalize(k)
  else numeric_conversion(e.kind,k) end
  return {kind=k,null_constant=e.null_constant and (ct.is_integer(k) or k == ct.pointer(Kind.Void))}
end

local function writable(e: Expr)
  if not e.lvalue or e.readonly or not scalar(e.kind) then fail('expected a modifiable scalar lvalue') end
end

-- The right-hand record address is in RAX and the destination address in RDX.
local function copy_record(target: Id, source_kind: Id)
  if target ~= source_kind or not ct.is_complete(target) then fail('incompatible record assignment') end
  if ct.size(target) == 0 then emit('movq %rdx, %rax'); return end
  uses_string_copy = true
  emit('movq %rax, %rsi')
  emit('movq %rdx, %rdi')
  emit('movq $' .. tostring(ct.size(target)) .. ', %rcx')
  emit('rep movsb')
  emit('movq %rdx, %rax')
end

local function step(k: Id): integer
  local n=ct.size(ct.element(k))
  if n <= 0 then fail('pointer arithmetic needs a complete object type') end
  return n
end

-- RAX holds the index and RCX the base. Native x86 scales cover most C arrays.
local function scaled_address(width: integer)
  if width == 1 then emit('addq %rcx, %rax')
  elseif width == 2 or width == 4 or width == 8 then
    emit('leaq (%rcx,%rax,' .. tostring(width) .. '), %rax')
  else
    emit('imulq $' .. tostring(width) .. ', %rax'); emit('addq %rcx, %rax')
  end
end

local function change(e: Expr, up: boolean, postfix: boolean): Expr
  writable(e)
  emit('movq %rax, %rcx'); load_memory(e.kind,'(%rcx)')
  if ct.long_double(e.kind) then
    if postfix then
      local old=reserve(Kind.LongDouble)
      store_memory(Kind.LongDouble,address(old)); emit('leaq ' .. address(old) .. ', %rax'); push_result()
    end
    emit('fld1'); emit('fldt (%rcx)')
    emit(up and 'faddp %st, %st(1)' or 'fsubp %st, %st(1)')
    local updated=reserve(Kind.LongDouble); emit('fstpt ' .. address(updated)); emit('leaq ' .. address(updated) .. ', %rax')
    store_memory(Kind.LongDouble,'(%rcx)')
    if postfix then pop_result('%rax') end
    return {kind=e.kind}
  end
  if postfix then emit('movq %rax, %r10') end
  if ct.floating(e.kind) then
    xmm_in(e.kind, '%xmm0')
    immediate(e.kind == Kind.Float and 0x3f800000 or 0x3ff0000000000000)
    xmm_in(e.kind, '%xmm1')
    emit(sse.arithmetic(e.kind, up and 'add' or 'sub', 1, 0))
    xmm_out(e.kind, '%xmm0')
  else
    local stride = ct.is_pointer(e.kind) and step(e.kind) or 1
    emit((up and 'addq $' or 'subq $') .. tostring(stride) .. ', %rax')
    if e.kind == Kind.Bool then truth(e.kind) else normalize(e.kind) end
  end
  store_memory(e.kind, '(%rcx)')
  if postfix then emit('movq %r10, %rax') end
  return {kind=e.kind}
end

local function condition(e: Expr)
  e=value(e)
  if not scalar(e.kind) then fail('condition must be scalar') end
  if ct.floating(e.kind) or ct.long_double(e.kind) then truth(e.kind) end
  emit('testq %rax, %rax')
end

local function expression(minimum: integer): Expr <forwarddecl> end
local function unary(): Expr <forwarddecl> end
local function statement_expression(): Expr <forwarddecl> end

local function local_init(k: Id, slot: integer) <forwarddecl> end

local function zero_local(k: Id, slot: integer)
  local off, size: integer = 0, ct.size(k)
  while off + 8 <= size do emit('movq $0, ' .. address(slot-off)); off=off+8 end
  if off + 4 <= size then emit('movl $0, ' .. address(slot-off)); off=off+4 end
  if off + 2 <= size then emit('movw $0, ' .. address(slot-off)); off=off+2 end
  if off < size then emit('movb $0, ' .. address(slot-off)) end
end

local Placement = @record{kind: Id, reg: integer, pad_before: integer, load_row: usize}
local Abi = @record{ms: boolean, gp: integer, sse: integer, stack: integer}

-- INTEGER and SSE arguments have independent register sequences in SysV.
local va_record: Id
local va_save_slot: integer
local va_fixed: Abi
local va_last: string

local function place(abi: *Abi,k: Id): Placement
  if ct.long_double(k) then
    if abi.ms then fail('unsupported Microsoft x64 long double argument') end
    local padding=abi.stack%2
    abi.stack=abi.stack+padding+2
    return {kind=k,pad_before=padding}
  end
  if abi.ms then
    if not scalar(k) then fail('unsupported Microsoft x64 argument type') end
    if abi.gp < 4 then abi.gp = abi.gp+1; return {kind=k, reg=abi.gp} end
  elseif ct.floating(k) then
    if abi.sse < 8 then abi.sse=abi.sse+1; return {kind=k,reg=abi.sse} end
  elseif ct.is_integer(k) or ct.is_pointer(k) then
    if abi.gp < 6 then abi.gp=abi.gp+1; return {kind=k,reg=abi.gp} end
  else fail('unsupported aggregate argument') end
  abi.stack=abi.stack+1
  return {kind=k}
end

local function record_classes(k: Id, parts: *[2]Id): integer
  local count = ct.abi_parts(k, parts)
  if count == 0 and ct.is_complete(k) and ct.size(k) == 0 then return 0 end
  if count == 0 then fail('unsupported aggregate calling convention') end
  return count
end

local function place_record(abi: *Abi, k: Id, locations: *sequence(Placement))
  if ct.is_complete(k) and ct.size(k) == 0 then return end -- The SysV ABI ignores empty record parameters.
  local parts: [2]Id
  local count = ct.abi_parts(k, &parts)
  if count == 0 and ct.memory_aggregate(k) then
    -- MEMORY-class aggregates are copied to the stack as rounded eightbytes.
    -- Each piece remains associated with the original record at the call site,
    -- where load_record_piece zero-extends a short final piece safely.
    local padding = abi.stack % 2
    abi.stack = abi.stack + padding
    count = (ct.size(k)+7)//8
    abi.stack = abi.stack + count
    for i = 0, count-1 do locations:push({kind=Kind.ULong, pad_before=i == 0 and padding or 0}) end
    return
  end
  if count == 0 then fail('unsupported aggregate calling convention') end
  local gp, sse: integer = 0, 0
  for i = 0, count-1 do
    if ct.floating(parts[i]) then sse = sse + 1 else gp = gp + 1 end
  end
  -- Both eightbytes go on the stack if either register class is exhausted.
  local spilled = abi.gp + gp > 6 or abi.sse + sse > 8
  for i = 0, count-1 do
    if spilled then abi.stack = abi.stack + 1; locations:push({kind=parts[i]})
    else locations:push(place(abi, parts[i])) end
  end
end

-- R11 holds the source address. Never read beyond the last byte of the object.
local function load_record_piece(k: Id, i: integer)
  local off = i*8
  local n = ct.size(k)-off
  local base = tostring(off) .. '(%r11)'
  if n >= 8 then emit('movq ' .. base .. ', %rax')
  elseif n == 4 then emit('movl ' .. base .. ', %eax')
  elseif n == 2 then emit('movzwl ' .. base .. ', %eax')
  elseif n == 1 then emit('movzbl ' .. base .. ', %eax')
  else
    emit('xorl %eax, %eax')
    for j = n-1, 0, -1 do
      if j < n-1 then emit('shlq $8, %rax') end
      emit('movb ' .. tostring(off+j) .. '(%r11), %al')
    end
  end
end

local function transfer_record_result(k: Id, returning: boolean)
  if ct.size(k) == 0 then return end -- The SysV ABI returns empty records without register pieces.
  local parts: [2]Id
  local count = record_classes(k, &parts)
  local slot: integer = 0
  if returning then emit('movq %rax, %r11') else slot = reserve(k) end
  local gp, xmm: integer = 0, 0
  -- R10 preserves the first INTEGER return while the second piece is loaded into RAX.
  for i = 0, count-1 do
    if returning then load_record_piece(k, i) end
    if ct.floating(parts[i]) then
      local reg = '%xmm' .. tostring(xmm)
      if returning then xmm_in(Kind.Double, reg)
      else emit('movq ' .. reg .. ', %r10'); emit('movq %r10, ' .. address(slot-i*8)) end
      xmm = xmm + 1
    else
      if returning then emit('movq %rax, ' .. (gp == 0 and '%r10' or '%rdx'))
      else emit('movq ' .. (gp == 0 and '%rax' or '%rdx') .. ', ' .. address(slot-i*8)) end
      gp = gp + 1
    end
  end
  if not returning then emit('leaq ' .. address(slot) .. ', %rax')
  elseif gp > 0 then emit('movq %r10, %rax') end
end

local function atomic_register(size: integer, register: string): string
  if size == 1 then
    if register == '%rax' then return '%al' end
    if register == '%rcx' then return '%cl' end
    if register == '%r10' then return '%r10b' end
    return '%r11b'
  elseif size == 2 then
    if register == '%rax' then return '%ax' end
    if register == '%rcx' then return '%cx' end
    if register == '%r10' then return '%r10w' end
    return '%r11w'
  elseif size == 4 then
    if register == '%rax' then return '%eax' end
    if register == '%rcx' then return '%ecx' end
    if register == '%r10' then return '%r10d' end
    return '%r11d'
  end
  return register
end

local function atomic_suffix(size: integer): string
  if size == 1 then return 'b' end
  if size == 2 then return 'w' end
  if size == 4 then return 'l' end
  return 'q'
end

local function atomic_kind(pointer: Id): Id
  if not ct.is_pointer(pointer) then fail('atomic operation requires a pointer') end
  local kind = ct.element(pointer)
  if kind == Kind.Bool then fail('atomic _Bool operands are not supported') end
  if not ct.is_integer(kind) and not ct.is_pointer(kind) then
    fail('atomic operation requires an integer or pointer type')
  end
  local size = ct.size(kind)
  if size ~= 1 and size ~= 2 and size ~= 4 and size ~= 8 then
    fail('unsupported atomic operand size')
  end
  return kind
end

local function atomic_value(value: Id, kind: Id)
  if not ct.is_integer(value) and not ct.is_pointer(value) then
    fail('atomic value must be an integer or pointer')
  end
  if ct.is_pointer(kind) then
    if not ct.is_pointer(value) and not ct.is_integer(value) then
      fail('atomic pointer value requires a pointer or integer')
    elseif ct.is_pointer(value) and not compatible_pointer(kind, value) then
      fail('incompatible atomic pointer value')
    end
  elseif not ct.is_integer(value) then
    fail('atomic integer value requires an integer')
  end
end

local function atomic_builtin(name: string): Expr
  local arguments: sequence(Id)
  if not take(')') then
    repeat
      arguments:push(value(expression(2)).kind)
      push_result()
    until not take(',')
    expect(')')
  end
  local arity: integer
  if name == '__atomic_load_n' then arity = 2
  elseif name == '__atomic_store_n' or name == '__atomic_exchange_n' or
         name == '__atomic_fetch_add' or name == '__atomic_add_fetch' or
         name == '__atomic_sub_fetch' then arity = 3
  else arity = 6 end
  if #arguments ~= arity then fail('wrong number of arguments for ' .. name) end

  local pointer = arguments[1]
  local kind = atomic_kind(pointer)
  if name == '__atomic_load_n' and not ct.is_integer(arguments[2]) then
    fail('atomic memory order must be an integer')
  elseif name == '__atomic_store_n' or name == '__atomic_exchange_n' or
         name == '__atomic_fetch_add' or name == '__atomic_add_fetch' or
         name == '__atomic_sub_fetch' then
    if not ct.is_integer(arguments[3]) then fail('atomic memory order must be an integer') end
  elseif name == '__atomic_compare_exchange_n' then
    if not ct.is_integer(arguments[4]) or not ct.is_integer(arguments[5]) or
       not ct.is_integer(arguments[6]) then fail('atomic memory order and weak flag must be integers') end
  end
  local size = ct.size(kind)
  local suffix = atomic_suffix(size)
  if name == '__atomic_load_n' then
    pop_result('%rcx') -- memory order
    pop_result('%r10') -- object pointer
    load_memory(kind, '(%r10)')
    return {kind=kind}
  elseif name == '__atomic_store_n' then
    atomic_value(arguments[2], kind)
    pop_result('%rcx') -- memory order
    pop_result('%r11') -- stored value
    pop_result('%r10') -- object pointer
    emit('xchg' .. suffix .. ' ' .. atomic_register(size, '%r11') .. ', (%r10)')
    return {kind=Kind.Void}
  elseif name == '__atomic_exchange_n' then
    atomic_value(arguments[2], kind)
    pop_result('%rcx') -- memory order
    pop_result('%r11') -- replacement value
    pop_result('%r10') -- object pointer
    emit('xchg' .. suffix .. ' ' .. atomic_register(size, '%r11') .. ', (%r10)')
    emit('movq %r11, %rax')
    normalize(kind)
    return {kind=kind}
  elseif name == '__atomic_fetch_add' or name == '__atomic_add_fetch' or
         name == '__atomic_sub_fetch' then
    if ct.is_pointer(kind) then fail('atomic pointer arithmetic is not supported') end
    atomic_value(arguments[2], kind)
    pop_result('%rcx') -- memory order
    pop_result('%r11') -- arithmetic value
    pop_result('%r10') -- object pointer
    local operand = atomic_register(size, '%r11')
    local saved = atomic_register(size, '%rcx')
    if name == '__atomic_sub_fetch' then emit('neg' .. suffix .. ' ' .. operand) end
    if name ~= '__atomic_fetch_add' then emit('mov' .. suffix .. ' ' .. operand .. ', ' .. saved) end
    emit('lock xadd' .. suffix .. ' ' .. operand .. ', (%r10)')
    if name ~= '__atomic_fetch_add' then emit('add' .. suffix .. ' ' .. saved .. ', ' .. operand) end
    emit('movq %r11, %rax')
    normalize(kind)
    return {kind=kind}
  else -- __atomic_compare_exchange_n
    if not ct.is_pointer(arguments[2]) or not compatible_pointer(arguments[2], pointer) then
      fail('atomic compare-exchange operand type mismatch')
    end
    atomic_value(arguments[3], kind)
    local done = label()
    pop_result('%rcx') -- failure order
    pop_result('%r8') -- success order
    pop_result('%r9') -- weak flag. Strong CAS also implements weak CAS.
    pop_result('%r11') -- desired value
    pop_result('%rdx') -- expected value pointer
    pop_result('%r10') -- object pointer
    load_memory(kind, '(%rdx)')
    emit('lock cmpxchg' .. suffix .. ' ' .. atomic_register(size, '%r11') .. ', (%r10)')
    emit('setz %r11b')
    emit('jz ' .. done)
    store_memory(kind, '(%rdx)')
    emit(done .. ':')
    emit('movzbq %r11b, %rax')
    return {kind=Kind.Bool}
  end
end

-- A trailing group of independent scalar loads can target the ABI registers
-- directly. Earlier expressions keep their stack snapshots across nested calls.
local function argument_load(line: string): boolean
  if line:subview(1,5) ~= '  mov' and line:subview(1,6) ~= '  leaq' then return false end
  local source=line:subview(1,-7) -- strip ", %rax" or ", %eax"
  local dest=line:subview(-6)
  return (dest==', %rax' or dest==', %eax') and
    (source:subview(-6)=='(%rbp)' or source:subview(-6)=='(%rip)' or
     source:subview(1,8)=='  movl $' or source:subview(1,8)=='  movq $')
end

local function place_direct_loads(args: *sequence(Placement), ms: boolean): integer
  local count=(@integer)(#($args))
  local staged=count
  -- Empty SysV record arguments have no placement but can emit side effects.
  -- Compact only snapshots still adjacent to the end of the argument list.
  local endrow=#body
  while staged>0 and endrow>=2 and ($args)[staged].load_row==endrow-1 do
    staged=staged-1
    endrow=endrow-2
  end
  local loads=count-staged
  local start=endrow
  for i: integer=1,loads do
    local line=body[start+2*i-1]
    local reg=argument_register(ms,($args)[staged+i].reg)
    if line:subview(-4)=='%eax' then
      reg=reg=='%r8' and '%r8d' or (reg=='%r9' and '%r9d' or '%e' .. reg:subview(3))
    end
    body[start+i]=line:subview(1,-5) .. reg
  end
  for i: integer=1,loads do body:pop() end
  depth=depth-loads
  return staged
end

-- Keep the two addresses alive while evaluating the count, which can itself call
-- a function. Small fixed copies use exact-width unaligned x86 loads and stores.
local function builtin_memcpy(): Expr
  local pointer_kind=ct.pointer(Kind.Void)
  convert(expression(2),pointer_kind,false); push_result()
  local saved_dest=#body
  expect(',')
  convert(expression(2),pointer_kind,false); push_result()
  expect(',')
  local start=#body
  local count=expression(2)
  local fixed=count.literal and count.mark==start+1 and #body==count.mark
  local n=count.number
  expect(')')
  if fixed and (n==0 or n==1 or n==2 or n==4 or n==8 or n==16) then
    body:pop() -- count immediate
    body:pop(); depth=depth-1 -- source is still in RAX
    if #body==saved_dest+1 and argument_load(body[#body]) and body[#body]:subview(-4)=='%rax' then
      -- This load is independent of RAX. Keep the destination there.
      local load=body:pop()
      body:pop(); depth=depth-1
      body:push(load:subview(1,-5) .. '%rcx')
    else
      emit('movq %rax, %rcx'); pop_result('%rax')
    end
    if n==1 then emit('movb (%rcx), %dl'); emit('movb %dl, (%rax)')
    elseif n==2 then emit('movw (%rcx), %dx'); emit('movw %dx, (%rax)')
    elseif n==4 then emit('movl (%rcx), %edx'); emit('movl %edx, (%rax)')
    elseif n>=8 then
      emit('movq (%rcx), %rdx'); emit('movq %rdx, (%rax)')
      if n==16 then emit('movq 8(%rcx), %rdx'); emit('movq %rdx, 8(%rax)') end
    end
  else
    convert(count,Kind.ULong,false)
    uses_string_copy=true
    emit('movq %rax, %rcx')
    pop_result('%rsi'); pop_result('%rdi')
    emit('movq %rdi, %rax'); emit('rep movsb')
  end
  return {kind=pointer_kind}
end

local function call(target: Expr): Expr
  if target.symbol == '__atomic_load_n' or target.symbol == '__atomic_store_n' or
     target.symbol == '__atomic_exchange_n' or target.symbol == '__atomic_fetch_add' or
     target.symbol == '__atomic_add_fetch' or target.symbol == '__atomic_sub_fetch' or
     target.symbol == '__atomic_compare_exchange_n' then
    return atomic_builtin(target.symbol)
  end
  local fn=target.kind
  local direct=#target.symbol > 0 and ct.is_function(fn)
  if not direct then
    fn=ct.element(value(target).kind)
    if not ct.is_function(fn) then fail('object is not a function') end
    push_result()
  end
  local sig=ct.signature(fn)
  if optimize_memcpy and direct and target.symbol=='memcpy' then
    local decl=functions[target.symbol]
    local ptr=ct.pointer(Kind.Void)
    if not decl.internal and not decl.defined and not sig.ms_abi and not sig.variadic and not sig.unspecified and
        sig.arity==3 and sig.result==ptr and sig.parameters[1]==ptr and sig.parameters[2]==ptr and sig.parameters[3]==Kind.ULong then
      return builtin_memcpy()
    end
  end
  if sig.ms_abi and ct.long_double(sig.result) then
    fail('unsupported Microsoft x64 long double result')
  end
  if not sig.ms_abi then calls_sysv = true end
  local args: sequence(Placement)
  local constants: smallinline.Constants
  local logical_count: integer = 0
  local abi: Abi = {ms=sig.ms_abi}
  local returned: integer = 0
  local sysv_memory_return = not sig.ms_abi and ct.memory_aggregate(sig.result)
  if (sig.ms_abi and ms_indirect(sig.result)) or sysv_memory_return then
    returned = aggregate_temporary(sig.result)
    emit('leaq ' .. address(returned) .. ', %rax')
    args:push(place(&abi,ct.pointer(sig.result))); push_result()
  end
  if not take(')') then
    repeat
      local start=#body
      local e=expression(2)
      local k: Id
      if logical_count < sig.arity then k=sig.parameters[logical_count+1]
      elseif sig.variadic or sig.unspecified then
        e=value(e)
        k=e.kind == Kind.Float and Kind.Double or ct.promote(e.kind)
      else fail('wrong number of arguments for ' .. target.symbol) end
      logical_count = logical_count + 1
      if ct.is_record(k) then
        if value(e).kind ~= k then fail('incompatible record argument') end
        if ct.size(k) == 0 and not abi.ms then
          -- Keep expression side effects, but GNU SysV assigns no argument location.
        elseif abi.ms then
          if ms_indirect(k) then
            local slot = aggregate_temporary(k)
            emit('leaq ' .. address(slot) .. ', %rdx'); copy_record(k,k)
          else emit('movq %rax, %r11'); load_record_piece(k,0) end
          args:push(place(&abi,Kind.ULong)); push_result()
        else
          local first = #args
          place_record(&abi, k, &args)
          emit('movq %rax, %r11')
          for i = 0, (@integer)(#args-first)-1 do load_record_piece(k, i); push_result() end
        end
      else
        convert(e, k, false)
        if ct.long_double(k) then
          local snapshot=reserve(k)
          store_memory(k,address(snapshot)); emit('leaq ' .. address(snapshot) .. ', %rax')
        end
        local a=place(&abi,k)
        if direct and not abi.ms and a.reg>0 and e.literal and (k==Kind.Int or k==Kind.UInt) then
          constants.known[a.reg-1]=true; constants.values[a.reg-1]=e.number
        end
        if a.reg~=0 and (ct.is_integer(k) or ct.is_pointer(k)) and
            #body==start+1 and argument_load(body[#body]) then a.load_row=#body end
        args:push(a); push_result()
      end
    until not take(',')
    expect(')')
  end
  local count=(@integer)(#args)
  if logical_count < sig.arity then fail('wrong number of arguments for ' .. target.symbol) end
  local duplicate_fp = abi.ms and (sig.variadic or sig.unspecified)
  if abi.stack == 0 then
    local staged=place_direct_loads(&args, abi.ms)
    for i=staged,1,-1 do
      local a=args[i]
      if ct.floating(a.kind) then
        pop_result('%rax'); xmm_in(a.kind,'%xmm' .. tostring(a.reg-1))
        if duplicate_fp then emit('movq %rax, ' .. argument_register(true,a.reg)) end
      else pop_result(argument_register(abi.ms,a.reg)) end
    end
    if not direct then pop_result('%r11') end
  else
    emit('movq %rsp, %r10')
    for i=1,count do
      local a=args[i]
      local src=tostring((count-i)*8) .. '(%r10)'
      if a.reg ~= 0 then
        if ct.floating(a.kind) then
          emit('movq ' .. src .. ', %rax'); xmm_in(a.kind, '%xmm' .. tostring(a.reg-1))
          if duplicate_fp then emit('movq %rax, ' .. argument_register(true,a.reg)) end
        else emit('movq ' .. src .. ', ' .. argument_register(abi.ms,a.reg)) end
      end
    end
    if not direct then emit('movq ' .. tostring(count*8) .. '(%r10), %r11') end
  end
  local pad=(depth+abi.stack)%2 ~= 0
  if pad then emit('subq $8, %rsp') end
  for i=count,1,-1 do
    if args[i].reg == 0 then
      if ct.long_double(args[i].kind) then
        emit('movq ' .. tostring((count-i)*8) .. '(%r10), %rax')
        emit('pushq 8(%rax)'); emit('pushq (%rax)')
      else emit('pushq ' .. tostring((count-i)*8) .. '(%r10)') end
      if args[i].pad_before > 0 then emit('pushq $0') end
    end
  end
  if abi.ms then emit('subq $32, %rsp')
  elseif sig.variadic or sig.unspecified then emit('movl $' .. tostring(abi.sse) .. ', %eax') end
  if not (direct and abi.stack==0 and smallinline.expand(target.symbol,&body,&slots,&constants,label)) then
    emit('call ' .. (direct and target.symbol or '*%r11'))
  end
  local reclaim=(pad and 1 or 0) + (abi.ms and 4 or 0)
  if abi.stack > 0 then
    local saved=count+(direct and 0 or 1)
    depth=depth-saved; reclaim=reclaim+abi.stack+saved
  end
  if reclaim > 0 then emit('addq $' .. tostring(reclaim*8) .. ', %rsp') end
  args:destroy()
  if ct.is_record(sig.result) then
    if sysv_memory_return then
      emit('leaq ' .. address(returned) .. ', %rax')
    elseif abi.ms then
      if returned == 0 then returned = reserve(sig.result); emit('movq %rax, ' .. address(returned)) end
      emit('leaq ' .. address(returned) .. ', %rax')
    else transfer_record_result(sig.result, false) end
    return {kind=sig.result}
  end
  if sig.result ~= Kind.Void and not scalar(sig.result) then fail('unsupported call result') end
  if ct.long_double(sig.result) then
    local slot=reserve(sig.result); emit('fstpt ' .. address(slot)); emit('leaq ' .. address(slot) .. ', %rax')
  elseif ct.floating(sig.result) then xmm_out(sig.result,'%xmm0') else normalize(sig.result) end
  return {kind=sig.result}
end

local function member(e: Expr, arrow: boolean): Expr
  local k = e.kind
  if arrow then k=ct.element(value(e).kind); e.readonly=false end
  if not ct.is_record(k) or ct.size(k) == 0 then fail('member access needs a complete struct or union') end
  local name=identifier()
  local field,offset_bytes=ct.member(k,name)
  if field == Kind.Unknown then fail('unknown field ' .. name) end
  if offset_bytes ~= 0 then emit('addq $' .. tostring(offset_bytes) .. ', %rax') end
  return {kind=field,lvalue=true,readonly=e.readonly}
end

local function resolve(name: string): Expr
  local v=locals[name]
  if v.level == 0 then
    if variables:has(name) then v=variables[name]
    elseif functions:has(name) then return {kind=ct.function_type(functions[name]),symbol=name}
    elseif enumerators:has(name) then
      local n=enumerators[name]; immediate(n)
      return {kind=Kind.Int,null_constant=n == 0,literal=true,number=n,mark=#body}
    elseif name == '__atomic_load_n' or name == '__atomic_store_n' or
           name == '__atomic_exchange_n' or name == '__atomic_fetch_add' or
           name == '__atomic_add_fetch' or name == '__atomic_sub_fetch' or
           name == '__atomic_compare_exchange_n' then
      return {symbol=name}
    else fail('undeclared local ' .. name) end
  end
  local place=v.slot ~= 0 and address(v.slot) or (v.symbol .. '(%rip)')
  if v.indirect then
    emit('movq ' .. place .. ', %rax'); return {kind=v.kind,lvalue=true}
  end
  emit('leaq ' .. place .. ', %rax')
  return {kind=v.kind,lvalue=true,readonly=v.readonly,place=place,mark=#body}
end

local function postfix(e: Expr): Expr
  while true do
    if take('(') then e=call(e)
    elseif take('[') then
      e=value(e); push_result()
      local index=value(expression(1))
      expect(']'); pop_result('%rcx')
      if ct.is_integer(e.kind) and ct.is_pointer(index.kind) then
        emit('xchgq %rcx, %rax'); e,index=index,e
      end
      if not ct.is_pointer(e.kind) or not ct.is_integer(index.kind) then fail('invalid subscript') end
      local width=step(e.kind)
      scaled_address(width)
      e={kind=ct.element(e.kind),lvalue=true}
    elseif take('.') then e=member(e,false)
    elseif take('->') then e=member(e,true)
    elseif take('++') then e=change(e,true,true)
    elseif take('--') then e=change(e,false,true)
    else break end
  end
  return e
end

local function va_pointer()
  if value(expression(2)).kind ~= ct.pointer(va_record) then fail('expected va_list') end
end

local function variadic_builtin(op: string): Expr
  expect('(')
  local ap = expression(2)
  -- The MS list points into a single contiguous run of eightbyte argument
  -- homes. The System V list is an array containing a descriptor.
  if ap.kind == ct.pointer(Kind.Char) and ap.lvalue then
    if op == '__builtin_ms_va_start' then
      if not function_ms or #va_last == 0 then fail('ms_va_start outside an MS variadic function') end
      expect(',')
      if identifier() ~= va_last then fail('va_start requires the last fixed parameter') end
      expect(')')
      emit('leaq ' .. tostring(16+(va_fixed.gp+va_fixed.stack)*8) .. '(%rbp), %rdx')
      emit('movq %rdx, (%rax)')
    elseif op == '__builtin_va_arg' then
      expect(',')
      local k = read_type()
      if not scalar(k) or k == Kind.Float or (ct.is_integer(k) and ct.promote(k) ~= k) then
        fail('unsupported or unpromoted Microsoft variadic argument type')
      end
      emit('movq (%rax), %rcx'); emit('addq $8, (%rax)'); load_memory(k,'(%rcx)')
      return {kind=k}
    elseif op == '__builtin_ms_va_copy' then
      push_result(); expect(',')
      if value(expression(2)).kind ~= ct.pointer(Kind.Char) then fail('invalid Microsoft va_list') end
      expect(')'); pop_result('%rcx'); emit('movq %rax, (%rcx)')
    elseif op == '__builtin_ms_va_end' then expect(')')
    else fail('invalid builtin for Microsoft va_list') end
    return {kind=Kind.Void}
  end
  if value(ap).kind ~= ct.pointer(va_record) then fail('expected va_list') end
  if op == '__builtin_va_start' then
    if va_save_slot == 0 then fail('va_start outside a variadic function') end
    expect(',')
    if identifier() ~= va_last then fail('va_start requires the last fixed parameter') end
    expect(')')
    emit('movl $' .. tostring(va_fixed.gp*8) .. ', (%rax)')
    emit('movl $' .. tostring(48 + va_fixed.sse*16) .. ', 4(%rax)')
    emit('leaq ' .. tostring(16 + va_fixed.stack*8) .. '(%rbp), %rdx')
    emit('movq %rdx, 8(%rax)')
    emit('leaq ' .. address(va_save_slot) .. ', %rdx')
    emit('movq %rdx, 16(%rax)')
  elseif op == '__builtin_va_arg' then
    expect(',')
    local k = read_type()
    if not scalar(k) or k == Kind.Float or (ct.is_integer(k) and ct.promote(k) ~= k) then
      fail('unsupported or unpromoted variadic argument type')
    end
    if ct.long_double(k) then
      emit('movq 8(%rax), %rcx'); emit('addq $15, %rcx'); emit('andq $-16, %rcx')
      emit('leaq 16(%rcx), %rdx'); emit('movq %rdx, 8(%rax)'); emit('movq %rcx, %rax')
      return {kind=k}
    end
    local floating = ct.floating(k)
    local field = floating and '4(%rax)' or '(%rax)'
    local stack, done = label(), label()
    emit('movl ' .. field .. ', %ecx')
    emit('cmpl $' .. (floating and '176' or '48') .. ', %ecx')
    emit('jae ' .. stack)
    emit('addl $' .. (floating and '16' or '8') .. ', ' .. field)
    emit('addq 16(%rax), %rcx')
    emit('jmp ' .. done)
    emit(stack .. ':')
    emit('movq 8(%rax), %rcx')
    emit('addq $8, 8(%rax)')
    emit(done .. ':')
    load_memory(k, '(%rcx)')
    return {kind=k}
  elseif op == '__builtin_va_copy' then
    push_result()
    expect(',')
    va_pointer()
    expect(')')
    pop_result('%rdx')
    copy_record(va_record, va_record)
  else expect(')') end
  return {kind=Kind.Void}
end

function unary(): Expr
  local op=token
  if op == '__builtin_va_start' or op == '__builtin_va_arg' or op == '__builtin_va_copy' or op == '__builtin_va_end' or
      op == '__builtin_ms_va_start' or op == '__builtin_ms_va_copy' or op == '__builtin_ms_va_end' then
    next_token()
    return postfix(variadic_builtin(op))
  elseif take('&') then
    local e=unary()
    if ct.is_function(e.kind) then return value(e) end
    if not e.lvalue then fail('address requires an lvalue') end
    return {kind=ct.pointer(e.kind)}
  elseif take('*') then
    local t=value(unary()).kind
    if not ct.is_pointer(t) or ct.element(t) == Kind.Void then fail('invalid pointer dereference') end
    return {kind=ct.element(t),lvalue=true}
  elseif take('++') or take('--') then return change(unary(),op == '++',false)
  elseif take('+') or take('-') or take('~') then
    local e=value(unary())
    if ct.long_double(e.kind) then
      if op == '~' then fail('integer operand required') end
      if op == '-' then
        emit('fldt (%rax)'); emit('fchs')
        local slot=reserve(Kind.LongDouble); emit('fstpt ' .. address(slot)); emit('leaq ' .. address(slot) .. ', %rax')
      end
      return {kind=e.kind}
    elseif ct.floating(e.kind) then
      if op == '~' then fail('integer operand required') end
      if op == '-' then emit(e.kind == Kind.Float and 'xorl $0x80000000, %eax' or 'btcq $63, %rax') end
      return {kind=e.kind}
    end
    if not ct.is_integer(e.kind) then fail('expected integer expression') end
    local k=ct.promote(e.kind)
    if op ~= '+' then
      emit((op == '-' and 'neg' or 'not') .. (ct.size(k) == 8 and 'q %rax' or 'l %eax'))
      normalize(k)
    end
    return {kind=k,null_constant=e.null_constant and op ~= '~'}
  elseif take('!') then
    condition(unary()); emit('sete %al'); emit('movzbl %al, %eax')
    return {kind=Kind.Int}
  elseif take('__builtin_memcpy') then expect('('); return postfix(builtin_memcpy())
  elseif take('__builtin_thread_pointer') then
    expect('('); expect(')')
    -- Linux x86-64 keeps the thread control block's self pointer at FS:0.
    emit('movq %fs:0, %rax')
    return postfix({kind=ct.pointer(Kind.Void)})
  elseif take('__builtin_offsetof') then
    local words: ce.Tokens
    words:push(op)
    expect('('); words:push('(')
    local depth: integer = 1
    while depth > 0 do
      if #token == 0 then fail('unterminated offsetof') end
      if token == '(' then depth = depth + 1 elseif token == ')' then depth = depth - 1 end
      words:push(token); next_token()
    end
    local n, ok = ce.evaluate(&words, &enumerators, &aliases)
    words:destroy()
    if not ok then fail('invalid offsetof operand') end
    immediate(n)
    return {kind=Kind.ULong, null_constant=n == 0}
  elseif take('sizeof') or take('_Alignof') then
    local k: Id
    local mark=#body
    if take('(') then
      if headers.starts_type(token,&aliases) and locals[token].level == 0 then k=read_type()
      else k=expression(1).kind; expect(')') end
    else k=unary().kind end
    while #body > mark do body:pop() end
    if not ct.is_complete(k) then fail('size requires a complete object type') end
    local n=op == 'sizeof' and ct.size(k) or ct.align(k)
    immediate(n)
    return {kind=Kind.ULong,literal=true,number=n,mark=#body}
  elseif take('(') then
    if take('{') then return postfix(statement_expression()) end
    if headers.starts_type(token,&aliases) and locals[token].level == 0 then
      local k=read_type()
      if token == '{' then
        local slot = reserve(k)
        zero_local(k, slot)
        local_init(k, slot)
        emit('leaq ' .. address(slot) .. ', %rax')
        return postfix({kind=k, lvalue=true})
      end
      return convert(unary(),k,true)
    end
    local e=expression(1); expect(')')
    return postfix(e)
  elseif #token > 0 and token:byte(1) == 34 then
    local bytes=strings()
    local name=string_symbol(&bytes)
    emit('leaq ' .. name .. '(%rip), %rax')
    local e: Expr={kind=ct.array(Kind.Char,(@integer)(#bytes)),lvalue=true}
    bytes:destroy()
    return postfix(e)
  elseif #token > 0 and token:byte(1) == 39 then
    local n,ok=ce.character(token)
    if not ok then fail('invalid character constant') end
    immediate(n); next_token()
    return postfix({kind=Kind.Int,null_constant=n == 0})
  elseif #token > 0 and (digit(token:byte(1)) or token:byte(1) == 46) then
    if fp.token(token) then
      if token:sub(-1):lower() == 'l' then
        local name=long_double_symbol(token)
        emit('leaq ' .. name .. '(%rip), %rax')
        next_token(); return postfix({kind=Kind.LongDouble})
      end
      local bits,k=fp.literal(token)
      if k == Kind.Unknown then fail('invalid or unsupported floating literal') end
      immediate(bits); next_token(); return postfix({kind=k})
    end
    local n,k,reason=ce.literal(token)
    if #reason > 0 then fail(reason) end
    immediate(n); next_token()
    return postfix({kind=k,null_constant=n == 0,literal=true,number=n,mark=#body})
  end
  return postfix(resolve(identifier()))
end

local function precedence(op: string): integer
  local n=#op
  if n==0 or n>3 then return 0 end
  local c=op.data[0]
  if n==1 then
    if c==','_b then return 1 elseif c=='='_b then return 2 elseif c=='?'_b then return 3
    elseif c=='|'_b then return 6 elseif c=='^'_b then return 7 elseif c=='&'_b then return 8
    elseif c=='<'_b or c=='>'_b then return 10 elseif c=='+'_b or c=='-'_b then return 12
    elseif c=='*'_b or c=='/'_b or c=='%'_b then return 13 end
  elseif n==2 then
    local d=op.data[1]
    if d=='='_b then
      if c=='='_b or c=='!'_b then return 9 elseif c=='<'_b or c=='>'_b then return 10
      elseif c=='+'_b or c=='-'_b or c=='*'_b or c=='/'_b or c=='%'_b or c=='&'_b or c=='|'_b or c=='^'_b then return 2 end
    elseif c==d then
      if c=='|'_b then return 4 elseif c=='&'_b then return 5 elseif c=='<'_b or c=='>'_b then return 11 end
    end
  elseif (c=='<'_b or c=='>'_b) and op.data[1]==c and op.data[2]==61 then return 2 end
  return 0
end

local function compare_result(op: string, unsigned: boolean): Expr
  local code: string
  if op == '==' then code='e' elseif op == '!=' then code='ne'
  elseif op == '<' then code=unsigned and 'b' or 'l'
  elseif op == '>' then code=unsigned and 'a' or 'g'
  elseif op == '<=' then code=unsigned and 'be' or 'le'
  else code=unsigned and 'ae' or 'ge' end
  emit('set' .. code .. ' %al'); emit('movzbl %al, %eax')
  return {kind=Kind.Int,cc=code,mark=#body}
end

local function compare(op: string, unsigned: boolean, wide: boolean): Expr
  emit(wide and 'cmpq %rax, %rcx' or 'cmpl %eax, %ecx')
  return compare_result(op,unsigned)
end

local function branch(e: Expr, target: string, when_true: boolean)
  if e.literal and #body==e.mark then
    body:pop()
    if (e.number~=0)==when_true then emit('jmp ' .. target) end
  elseif #e.cc>0 and #body==e.mark then
    body:pop(); body:pop()
    local cc=e.cc
    if not when_true then
      if cc=='e' then cc='ne' elseif cc=='ne' then cc='e'
      elseif cc=='l' then cc='ge' elseif cc=='ge' then cc='l'
      elseif cc=='g' then cc='le' elseif cc=='le' then cc='g'
      elseif cc=='b' then cc='ae' elseif cc=='ae' then cc='b'
      elseif cc=='a' then cc='be' else cc='a' end
    end
    emit('j' .. cc .. ' ' .. target)
  else
    condition(e)
    emit((when_true and 'jne ' or 'je ') .. target)
  end
end

local function float_binary(op: string,a: Expr,b: Expr,k: Id): Expr
  push_result()
  emit('movq %rcx, %rax')
  convert(a,k,false); xmm_in(k,'%xmm2')
  pop_result('%rax')
  convert(b,k,false); xmm_in(k,'%xmm0')
  if op == '+' or op == '-' or op == '*' or op == '/' then
    local instruction=op == '+' and 'add' or (op == '-' and 'sub' or (op == '*' and 'mul' or 'div'))
    emit(sse.arithmetic(k, instruction, 0, 2)); xmm_out(k,'%xmm2')
    return {kind=k}
  elseif op == '==' or op == '!=' or op == '<' or op == '<=' or op == '>' or op == '>=' then
    if op == '<' or op == '<=' then emit(sse.compare(k, 2, 0))
    else emit(sse.compare(k, 0, 2)) end
    if op == '==' then emit('sete %al'); emit('setnp %dl'); emit('andb %dl, %al')
    elseif op == '!=' then emit('setne %al'); emit('setp %dl'); emit('orb %dl, %al')
    elseif op == '<' or op == '>' then emit('seta %al')
    else emit('setae %al') end
    emit('movzbl %al, %eax')
    return {kind=Kind.Int}
  end
  fail('invalid floating-point operator ' .. op)
  return {}
end

-- Long double expressions are addresses of 16-byte temporaries. Keep the
-- x87 stack transient so normal C expression evaluation never leaks x87 depth.
local function long_double_binary(op: string): Expr
  emit('fldt (%rax)') -- right operand
  emit('fldt (%rcx)') -- left operand
  if op == '==' or op == '!=' or op == '<' or op == '<=' or op == '>' or op == '>=' then
    emit('fucomip %st(1), %st'); emit('fstp %st(0)')
    if op == '==' then emit('sete %al'); emit('setnp %dl'); emit('andb %dl, %al')
    elseif op == '!=' then emit('setne %al'); emit('setp %dl'); emit('orb %dl, %al')
    elseif op == '<' then emit('setb %al'); emit('setnp %dl'); emit('andb %dl, %al')
    elseif op == '<=' then emit('setbe %al'); emit('setnp %dl'); emit('andb %dl, %al')
    elseif op == '>' then emit('seta %al')
    else emit('setae %al') end
    emit('movzbl %al, %eax')
    return {kind=Kind.Int}
  end
  local instruction=op == '+' and 'faddp' or (op == '-' and 'fsubp' or (op == '*' and 'fmulp' or (op == '/' and 'fdivp' or '')))
  if #instruction == 0 then fail('invalid long double operator ' .. op) end
  emit(instruction .. ' %st, %st(1)')
  local slot=reserve(Kind.LongDouble)
  emit('fstpt ' .. address(slot)); emit('leaq ' .. address(slot) .. ', %rax')
  return {kind=Kind.LongDouble}
end

-- At entry RCX holds the left operand and RAX holds the right.
local function binary(op: string, a: Expr, b: Expr): Expr
  local equality=op == '==' or op == '!='
  local comparison=equality or op == '<' or op == '>' or op == '<=' or op == '>='
  if ct.is_pointer(a.kind) or ct.is_pointer(b.kind) then
    if comparison and ((ct.is_pointer(a.kind) and ct.is_pointer(b.kind) and compatible_pointer(a.kind,b.kind)) or
        (equality and (a.null_constant or b.null_constant))) then return compare(op,true,true) end
    if op == '+' and ct.is_integer(a.kind) and ct.is_pointer(b.kind) then
      emit('xchgq %rax, %rcx'); a,b=b,a
    end
    if ct.is_pointer(a.kind) and ct.is_integer(b.kind) and (op == '+' or op == '-') then
      local width=step(a.kind)
      if op == '-' then emit('negq %rax') end
      scaled_address(width); return {kind=a.kind}
    elseif op == '-' and ct.is_pointer(a.kind) and a.kind == b.kind then
      local width=step(a.kind)
      emit('subq %rax, %rcx'); emit('movq %rcx, %rax')
      if width ~= 1 then emit('movq $' .. tostring(width) .. ', %rcx'); emit('cqto'); emit('idivq %rcx') end
      return {kind=Kind.Long}
    end
    fail('invalid pointer operands')
  end
  if ct.long_double(a.kind) or ct.long_double(b.kind) then
    if a.kind ~= Kind.LongDouble or b.kind ~= Kind.LongDouble then
      push_result(); emit('movq %rcx, %rax'); convert(a,Kind.LongDouble,false); emit('movq %rax, %rcx')
      pop_result('%rax'); convert(b,Kind.LongDouble,false)
    end
    return long_double_binary(op)
  elseif ct.floating(a.kind) or ct.floating(b.kind) then
    if not scalar(a.kind) or not scalar(b.kind) then fail('expected arithmetic operands') end
    return float_binary(op,a,b,ct.common(a.kind,b.kind))
  end
  if not ct.is_integer(a.kind) or not ct.is_integer(b.kind) then fail('expected integer operands') end
  local shift=op == '<<' or op == '>>'
  local k=shift and ct.promote(a.kind) or ct.common(a.kind,b.kind)
  local wide=ct.size(k) == 8
  if comparison then return compare(op,ct.unsigned(k),wide) end
  local suffix=wide and 'q' or 'l'
  local acc,other,rem: string = wide and '%rax' or '%eax',wide and '%rcx' or '%ecx',wide and '%rdx' or '%edx'
  if op == '+' then emit('add' .. suffix .. ' ' .. other .. ', ' .. acc)
  elseif op == '-' then
    emit('sub' .. suffix .. ' ' .. acc .. ', ' .. other); emit('mov' .. suffix .. ' ' .. other .. ', ' .. acc)
  elseif op == '&' or op == '|' or op == '^' then
    emit((op == '&' and 'and' or (op == '|' and 'or' or 'xor')) .. suffix .. ' ' .. other .. ', ' .. acc)
  elseif shift then
    emit('xchg' .. suffix .. ' ' .. acc .. ', ' .. other)
    emit((op == '<<' and 'shl' or (ct.unsigned(k) and 'shr' or 'sar')) .. suffix .. ' %cl, ' .. acc)
  elseif op == '*' then emit('imul' .. suffix .. ' ' .. other .. ', ' .. acc)
  else
    emit('xchg' .. suffix .. ' ' .. acc .. ', ' .. other)
    if ct.unsigned(k) then emit('xorl %edx, %edx'); emit('div' .. suffix .. ' ' .. other)
    else emit(wide and 'cqto' or 'cltd'); emit('idiv' .. suffix .. ' ' .. other) end
    if op == '%' then emit('mov' .. suffix .. ' ' .. rem .. ', ' .. acc) end
  end
  normalize(k)
  return {kind=k}
end

-- For a single load or immediate on the right, use the corresponding x86
-- operand directly. A complex expression can call functions or change memory
-- and must keep its original evaluation order and saved left operand.
local function finish_integer(op: string,a: Expr,b: Expr,mark: usize): Expr
  if #body==mark+2 and b.mark==#body and ct.is_integer(a.kind) and ct.is_integer(b.kind) then
    if a.literal and a.mark==mark and b.literal then
      local ok,n,k=ce.fold_binary(op,a.number,a.kind,b.number,b.kind)
      if ok then
        body:pop(); body:pop(); body:pop(); depth=depth-1
        immediate(n)
        return {kind=k,literal=true,number=n,mark=#body}
      end
    end
    if b.literal and (op == '<<' or op == '>>') then
      local k=ct.promote(a.kind)
      local wide=ct.size(k)==8
      if b.number>=0 and b.number<ct.size(k)*8 then
        body:pop(); body:pop(); depth=depth-1
        local shift=op=='<<' and 'shl' or (ct.unsigned(k) and 'shr' or 'sar')
        emit(shift .. (wide and 'q $' or 'l $') .. tostring(b.number) .. (wide and ', %rax' or ', %eax'))
        normalize(k)
        return {kind=k}
      end
    end
    local k=ct.common(a.kind,b.kind)
    local width=ct.size(k)
    local source: string
    if b.literal and b.number>=-2147483648 and b.number<=2147483647 then
      source='$' .. tostring(b.number)
    elseif #b.place>0 and ct.size(b.kind)==width then
      source=b.place
    end
    local instruction: string
    if op=='+' then instruction='add' elseif op=='-' then instruction='sub'
    elseif op=='*' then instruction='imul' elseif op=='&' then instruction='and'
    elseif op=='|' then instruction='or' elseif op=='^' then instruction='xor'
    elseif op=='==' or op=='!=' or op=='<' or op=='>' or op=='<=' or op=='>=' then instruction='cmp' end
    if #instruction>0 and #source>0 then
      body:pop(); body:pop(); depth=depth-1
      emit(instruction .. (width==8 and 'q ' or 'l ') .. source .. (width==8 and ', %rax' or ', %eax'))
      if instruction=='cmp' then return compare_result(op,ct.unsigned(k)) end
      normalize(k)
      return {kind=k}
    end
  end
  pop_result('%rcx')
  return binary(op,a,b)
end

function expression(minimum: integer): Expr
  local e: Expr = unary()
  while true do
    local p=precedence(token)
    if p<minimum then break end
    local op=token
    next_token()
    if op == ',' then value(e); e=value(expression(p+1))
    elseif p == 2 then
      if op == '=' and ct.is_record(e.kind) then
        if not e.lvalue or e.readonly then fail('expected a modifiable record lvalue') end
        push_result()
        local rhs = value(expression(p))
        pop_result('%rdx')
        copy_record(e.kind, rhs.kind)
      else
        writable(e)
        local direct=#e.place>0 and #body==e.mark
        if direct then body:pop() else push_result() end
        local mark=#body
        if op~='=' then
          load_memory(e.kind,direct and e.place or '(%rax)')
          mark=#body
          push_result()
        end
        local rhs=value(expression(p))
        if op~='=' then rhs=finish_integer(op:subview(1,-2),{kind=e.kind},rhs,mark) end
        convert(rhs,e.kind,false)
        if direct then store_memory(e.kind,e.place)
        else pop_result('%rdx'); store_memory(e.kind,'(%rdx)') end
      end
      e={kind=e.kind}
    elseif op == '?' then
      local other,yes_convert,done=label(),label(),label()
      branch(e,other,false)
      local yes=value(expression(1)); expect(':')
      emit('jmp ' .. yes_convert); emit(other .. ':')
      local no=value(expression(p))
      local k=yes.kind
      if (ct.is_integer(k) or ct.floating(k) or ct.long_double(k)) and
          (ct.is_integer(no.kind) or ct.floating(no.kind) or ct.long_double(no.kind)) then k=ct.common(k,no.kind)
      elseif ct.is_pointer(k) and no.null_constant then
      elseif ct.is_pointer(no.kind) and yes.null_constant then k=no.kind
      elseif ct.is_pointer(k) and ct.is_pointer(no.kind) and compatible_pointer(k,no.kind) then
        if ct.element(no.kind) == Kind.Void then k=no.kind end
      elseif k ~= no.kind then fail('incompatible conditional operands') end
      if scalar(k) then convert(no,k,false) end
      emit('jmp ' .. done); emit(yes_convert .. ':')
      if scalar(k) then convert(yes,k,false) end
      emit(done .. ':'); e={kind=k}
    elseif op == '&&' or op == '||' then
      -- A constant left operand can require evaluation of the right on every path.
      local always_rhs=e.literal and e.mark==#body and ((e.number~=0)==(op=='&&'))
      local short,done: string
      if always_rhs then body:pop()
      else short,done=label(),label(); branch(e,short,op=='||') end
      e=expression(p+1)
      if #e.cc==0 or e.mark~=#body then
        condition(e); emit('setne %al'); emit('movzbl %al, %eax')
        e={kind=Kind.Int}
      end
      if not always_rhs then
        emit('jmp ' .. done); emit(short .. ':'); immediate(op == '&&' and 0 or 1); emit(done .. ':')
        e={kind=Kind.Int}
      end
    else
      e=value(e)
      local mark=#body
      push_result()
      local rhs=value(expression(p+1))
      e=finish_integer(op,e,rhs,mark)
    end
  end
  return e
end

local function read_constant(): headers.Tokens
  local words: headers.Tokens
  local nest: integer=0
  while #token > 0 and (nest > 0 or (token ~= ',' and token ~= '}' and token ~= ';')) do
    if token == '(' then nest=nest+1 elseif token == ')' then nest=nest-1 end
    words:push(token); next_token()
  end
  return words
end

local function static_assertion()
  expect('_Static_assert')
  expect('(')
  local words = read_constant()
  local n, ok = ce.evaluate(&words, &enumerators, &aliases)
  words:destroy()
  expect(',')
  if #token == 0 or token:byte(1) ~= 34 then fail('expected static assertion message') end
  local message = token
  repeat next_token() until #token == 0 or token:byte(1) ~= 34
  expect(')')
  expect(';')
  if not ok then fail('expected integer constant expression in static assertion') end
  if n == 0 then fail('static assertion failed: ' .. message) end
end

local function space(out: *sequence(string), n: integer)
  if n > 0 then out:push('  .space ' .. tostring(n)) end
end

local function address_initializer(words: *headers.Tokens, first: usize, last: usize): (string, integer, Id)
  local address = first <= last and ($words)[first] == '&'
  local at = address and first + 1 or first
  if at > last then return '', 0, Kind.Unknown end
  local name = ($words)[at]
  if not variables:has(name) then return '', 0, Kind.Unknown end
  local variable = variables[name]
  local kind, addend: Id, integer = variable.kind, 0
  local one_past = false
  at = at + 1
  while at <= last do
    local token = ($words)[at]
    if token == '.' then
      if one_past or at == last or not ct.is_record(kind) then return '', 0, Kind.Unknown end
      local member_kind, member_offset = ct.member(kind, ($words)[at + 1])
      if member_kind == Kind.Unknown then return '', 0, Kind.Unknown end
      if member_offset > 9223372036854775807 - addend then fail('address initializer offset overflow') end
      addend = addend + member_offset
      kind = member_kind
      at = at + 2
    elseif token == '[' then
      local close = at + 1
      local nesting = 1
      while close <= last and nesting > 0 do
        if ($words)[close] == '[' then nesting = nesting + 1
        elseif ($words)[close] == ']' then nesting = nesting - 1 end
        if nesting > 0 then close = close + 1 end
      end
      if nesting ~= 0 or not ct.is_array(kind) then return '', 0, Kind.Unknown end
      local index_tokens: ce.Tokens
      for i = at + 1, close - 1 do index_tokens:push(($words)[i]) end
      local index, ok = ce.evaluate(&index_tokens, &enumerators, &aliases)
      index_tokens:destroy()
      local count, element = ct.count(kind), ct.element(kind)
      if not ok or index < 0 or ct.size(element) == 0 or (count > 0 and index > count) then
        return '', 0, Kind.Unknown
      end
      local element_size = ct.size(element)
      if index > (9223372036854775807 - addend) // element_size then fail('address initializer offset overflow') end
      addend = addend + index * element_size
      kind = element
      at = close + 1
      if count > 0 and index == count then one_past = true end
      if one_past and at <= last then return '', 0, Kind.Unknown end
    else
      return '', 0, Kind.Unknown
    end
  end
  if not address and (not ct.is_array(kind) or one_past) then return '', 0, Kind.Unknown end
  if not address then kind = ct.element(kind) end
  return variable.symbol, addend, ct.pointer(kind)
end

local function address_constant(words: *headers.Tokens, first: usize, last: usize): (string, Id)
  if first > last then fail('expected pointer initializer') end
  if ($words)[first] == '(' then
    local close=first+1
    local nesting: integer=1
    while close <= last do
      local w=($words)[close]
      if w == '(' then nesting=nesting+1 elseif w == ')' then nesting=nesting-1 end
      if nesting == 0 then break end
      close=close+1
    end
    if close == last then return address_constant(words,first+1,last-1) end
    if close < last and headers.starts_type(($words)[first+1],&aliases) then
      local cast: headers.Tokens
      for i=first+1,close-1 do cast:push(($words)[i]) end
      local d=headers.parse(&cast,&aliases,&enumerators)
      if not ct.is_pointer(d.kind) or #d.name ~= 0 then fail('unsupported address initializer cast') end
      cast:destroy()
      local symbol=address_constant(words,close+1,last)
      return symbol,d.kind
    end
  end
  if ($words)[first]:byte(1) == 34 then
    local bytes: sequence(byte)
    for i = first,last do
      if ($words)[i]:byte(1) ~= 34 then fail('expected string literal') end
      literal_bytes(($words)[i],&bytes)
    end
    bytes:push(0)
    local name = string_symbol(&bytes); bytes:destroy()
    return name,ct.pointer(Kind.Char)
  end
  local name, addend, address_type = address_initializer(words, first, last)
  if address_type ~= Kind.Unknown then
    return addend == 0 and name or name .. '+' .. tostring(addend),address_type
  end
  local addr=($words)[first] == '&'
  local at=addr and first+1 or first
  if at == last then
    local name=($words)[at]
    if functions:has(name) then
      return name,ct.pointer(ct.function_type(functions[name]))
    end
  end
  local expr: ce.Tokens
  for i=first,last do expr:push(($words)[i]) end
  local n,ok=ce.evaluate(&expr, &enumerators, &aliases)
  expr:destroy()
  if ok and n == 0 then return '0',Kind.Unknown end
  fail('expected a constant address or null pointer')
  return '',Kind.Unknown
end

local function byte_array(k: Id): boolean
  local e=ct.element(k)
  return ct.is_array(k) and (e == Kind.Char or e == Kind.SChar or e == Kind.UChar)
end

local function floating_initializer(words: *ce.Tokens, k: Id): (integer,uint64,uint16)
  local first, last: integer = 1, (@integer)(#($words))
  while first < last and ($words)[first] == '(' and ($words)[last] == ')' do
    first, last = first + 1, last - 1
  end
  if first <= last then
    local sign = ($words)[first]
    if sign == '+' or sign == '-' then first = first + 1 end
    if first == last and fp.token(($words)[first]) then
      local suffix = ($words)[first]:byte(-1)
      if suffix == 76 or suffix == 108 then
        local significand,sign_exponent,from=fp.literal_long_double(($words)[first])
        if from == Kind.Unknown then fail('invalid floating initializer') end
        if sign == '-' then sign_exponent=sign_exponent ~ 0x8000 end
        return fp.constant(0,significand,sign_exponent,from,k)
      end
      local bits, from = fp.literal(($words)[first])
      if from == Kind.Unknown then fail('invalid floating initializer') end
      if sign == '-' then bits = bits ~ (from == Kind.Float and 0x80000000 or (-9223372036854775807-1)) end
      return fp.constant(bits,0,0,from,k)
    end
  end
  local n, ok, from = ce.evaluate(words, &enumerators, &aliases)
  if not ok then fail('unsupported floating constant expression') end
  return fp.constant(n,0,0,from,k)
end

local InitializerTarget = @record{kind: Id, offset: integer, index: integer}
local Fragment = @record{offset: integer, size: integer, lines: sequence(string)}

local function initializer_target(k: Id, index: integer): InitializerTarget
  if ct.is_array(k) then
    if take('[') then
      local words: ce.Tokens
      local brackets: integer = 0
      while #token > 0 and (brackets > 0 or token ~= ']') do
        if token == '[' then brackets = brackets + 1 elseif token == ']' then brackets = brackets - 1 end
        words:push(token); next_token()
      end
      expect(']'); expect('=')
      local n, ok = ce.evaluate(&words, &enumerators, &aliases)
      words:destroy()
      if not ok or n < 0 then fail('invalid array designator') end
      index = n
    end
    local child = ct.element(k)
    local bound = ct.count(k)
    if (bound > 0 and index >= bound) or index >= 9223372036854775807 // ct.size(child) then
      fail('excess array initializer')
    end
    return {kind=child, offset=index*ct.size(child), index=index}
  end
  local fields = ct.members(k)
  if take('.') then
    local name = identifier()
    expect('=')
    index = 0
    while index < (@integer)(#($fields)) and ($fields)[index+1].name ~= name do index = index + 1 end
    if index >= (@integer)(#($fields)) then fail('unknown initializer field ' .. name) end
  elseif ct.is_union(k) and index ~= 0 then fail('excess union initializer') end
  if index >= (@integer)(#($fields)) then fail('excess struct initializer') end
  local field = ($fields)[index+1]
  return {kind=field.kind, offset=field.offset, index=index}
end

-- Collect fragments in layout order. Later designators override earlier values.
local function insert_fragment(fragments: *sequence(Fragment), item: Fragment)
  local at = #($fragments)
  while at > 0 and ($fragments)[at].offset > item.offset do at = at - 1 end
  if at > 0 and ($fragments)[at].offset == item.offset then
    local previous = &($fragments)[at]
    previous.lines:destroy()
    $previous = item
  else fragments:insert(at + 1, item) end
end

-- A braced zero initializer initializes every subobject, even when the first
-- member is itself an aggregate. Recognize this common C form before recursively
-- parsing the first element as though it needed another pair of braces.
local function consume_zero_brace_initializer(): boolean
  if token ~= '{' then return false end
  local at,ln,tl,head,path,current,qualified=offset,line,token_line,inside_header,source_path,token,qualified_storage
  next_token()
  if token ~= '0' then
    offset,line,token_line,inside_header,source_path,token,qualified_storage=at,ln,tl,head,path,current,qualified
    return false
  end
  next_token()
  if token == ',' then next_token() end
  if token ~= '}' then
    offset,line,token_line,inside_header,source_path,token,qualified_storage=at,ln,tl,head,path,current,qualified
    return false
  end
  next_token()
  return true
end

local function global_init(k: Id, out: *sequence(string)): Id
  if byte_array(k) and #token > 0 and token:byte(1) == 34 then
    local bytes = strings()
    local count, bound = (@integer)(#bytes), ct.count(k)
    if bound == 0 then bound = count end
    if bound < count - 1 then fail('excess array initializer') end
    if bound < count then count = bound end
    for i = 1, count do out:push('  .byte ' .. tostring(bytes[i])) end
    bytes:destroy()
    space(out, bound-count)
    return ct.array(ct.element(k), bound)
  elseif ct.is_record(k) or ct.is_array(k) then
    if consume_zero_brace_initializer() then
      if ct.is_array(k) and ct.count(k) == 0 then k=ct.array(ct.element(k),1) end
      if not ct.is_complete(k) then fail('initializer needs a complete type') end
      space(out,ct.size(k))
      return k
    end
    expect('{')
    local fragments: sequence(Fragment)
    local next_index, max_count: integer = 0, 0
    while token ~= '}' do
      local target = initializer_target(k, next_index)
      local fragment: Fragment = {offset=target.offset, size=ct.size(target.kind)}
      global_init(target.kind, &fragment.lines)
      insert_fragment(&fragments, fragment)
      next_index = target.index + 1
      if next_index > max_count then max_count = next_index end
      if not take(',') then break end
    end
    expect('}')
    if ct.is_array(k) and ct.count(k) == 0 then k = ct.array(ct.element(k), max_count) end
    if not ct.is_complete(k) then fail('initializer needs a complete type') end
    local offset: integer = 0
    for i: usize = 1, #fragments do
      local fragment = &fragments[i]
      space(out, fragment.offset - offset)
      for j: usize = 1, #fragment.lines do out:push(fragment.lines[j]) end
      offset = fragment.offset + fragment.size
      fragment.lines:destroy()
    end
    fragments:destroy()
    space(out, ct.size(k)-offset)
  elseif take('{') then
    global_init(k,out); take(','); expect('}')
  else
    local words=read_constant()
    if ct.is_pointer(k) then
      local symbol,source_type=address_constant(&words,1,#words)
      if symbol ~= '0' and not compatible_pointer(source_type,k) then
        if ct.is_function(ct.element(source_type)) then fail('incompatible function pointer') end
        fail('incompatible pointer initializer')
      end
      out:push('  .quad ' .. symbol)
    elseif ct.floating(k) or ct.long_double(k) then
      local bits,significand,sign_exponent = floating_initializer(&words, k)
      if ct.long_double(k) then
        out:push('  .quad ' .. tostring(significand)); out:push('  .short ' .. tostring(sign_exponent))
        for i=1,6 do out:push('  .byte 0') end
      else out:push((k == Kind.Float and '  .long ' or '  .quad ') .. tostring(bits)) end
    else
      if not ct.is_integer(k) then fail('unsupported initializer') end
      local v,ok=ce.evaluate(&words, &enumerators, &aliases)
      if not ok then fail('invalid or unsupported integer constant expression') end
      if k == Kind.Bool then v=v ~= 0 and 1 or 0 end
      local n=ct.size(k)
      if n == 1 then out:push('  .byte ' .. tostring((@uint8)(v)))
      elseif n == 2 then out:push('  .short ' .. tostring((@uint16)(v)))
      elseif n == 4 then out:push('  .long ' .. tostring((@int32)(v)))
      else out:push('  .quad ' .. tostring(v)) end
    end
    words:destroy()
  end
  return k
end

local function object_start(v: Variable,out: *sequence(string))
  out:push('.balign ' .. tostring(ct.align(v.kind)))
  if not v.internal then out:push('.globl ' .. v.symbol) end
  out:push('.type ' .. v.symbol .. ', @object'); out:push(v.symbol .. ':')
end

-- Apply weak binding after all definitions, including attributes on redeclarations.
local weak_symbols: sequence(string)
local weak_instructions: hashmap(string,string)
local function weak_binding(d: headers.Declaration, internal: boolean)
  if d.weak then
    if internal then fail('weak symbol must have external linkage: ' .. d.name) end
    local call = '  call ' .. d.name
    if weak_instructions:has(call) then return end
    local pointer = '.Lnecc_weak_' .. d.name .. '(%rip)'
    weak_instructions[call] = '  call *' .. pointer
    weak_instructions['  leaq ' .. d.name .. '(%rip), %rax'] = '  movq ' .. pointer .. ', %rax'
    weak_symbols:push(d.name)
  end
end

local tentative: sequence(string)
local function global_object(d: headers.Declaration, init: boolean, from_header: boolean)
  local name=d.name
  if functions:has(name) or enumerators:has(name) or aliases:has(name) then fail('duplicate global ' .. name) end
  local v: Variable = variables[name]
  if v.kind ~= Kind.Unknown then
    local same=v.kind == d.kind or (ct.is_array(v.kind) and ct.is_array(d.kind) and
      ct.element(v.kind) == ct.element(d.kind) and (ct.count(v.kind) == 0 or ct.count(d.kind) == 0))
    if not same or (d.internal and not v.internal) then fail('conflicting declaration for ' .. name) end
    if ct.is_array(v.kind) and ct.count(v.kind) == 0 then v.kind=d.kind end
  else
    v={kind=d.kind,symbol=d.internal and '.Lnecc_global_' .. name or name,internal=d.internal,
       readonly=d.readonly and not ct.is_pointer(d.kind)}
  end
  weak_binding(d,v.internal)
  variables[name]=v
  if init then
    if v.defined then fail('duplicate global ' .. name) end
    local out=v.readonly and &rodata or &data
    object_start(v,out); v.kind=global_init(v.kind,out)
    out:push('.size ' .. v.symbol .. ', .-' .. v.symbol); v.defined=true
  elseif not from_header and not d.external and not v.tentative then
    v.tentative=true; tentative:push(name)
  end
  variables[name]=v
end

function local_init(k: Id, slot: integer)
  if byte_array(k) and #token > 0 and token:byte(1) == 34 then
    local bytes = strings()
    if (@integer)(#bytes)-1 > ct.count(k) then fail('excess array initializer') end
    for i = 1, ct.count(k) do
      if i > (@integer)(#bytes) then break end
      emit('movb $' .. tostring(bytes[i]) .. ', ' .. address(slot-i+1))
    end
    bytes:destroy()
  elseif ct.is_record(k) or ct.is_array(k) then
    if ct.is_record(k) and token ~= '{' then
      local source_value = value(expression(2))
      emit('leaq ' .. address(slot) .. ', %rdx')
      copy_record(k, source_value.kind)
      return
    end
    if consume_zero_brace_initializer() then
      -- A later designated initializer may replace a previously initialized
      -- aggregate, so clear its full storage before applying the zero value.
      zero_local(k,slot)
      return
    end
    expect('{')
    local next_index: integer = 0
    while token ~= '}' do
      local target = initializer_target(k, next_index)
      local_init(target.kind, slot-target.offset)
      next_index = target.index + 1
      if not take(',') then break end
    end
    expect('}')
  elseif take('{') then local_init(k,slot); take(','); expect('}')
  else convert(expression(2),k,false); store_memory(k,address(slot)) end
end

local function enum_declaration(words: *headers.Tokens): boolean
  local added: ce.Names
  if not ce.enumeration(words, &enumerators, &added, &aliases) then return false end
  for name,n in pairs(added) do
    if not allowed_name(name) or functions:has(name) or variables:has(name) or aliases:has(name) then
      fail('invalid or conflicting enumerator ' .. name)
    end
    enumerators[name]=n
  end
  if ($words)[1] == 'typedef' then aliases[($words)[#($words)]]=Kind.Int end
  added:destroy()
  return true
end

local function register_fn(d: headers.Declaration, definition: boolean): ct.Signature
  if variables:has(d.name) or aliases:has(d.name) or enumerators:has(d.name) then fail('duplicate global ' .. d.name) end
  local sig=ct.signature(d.kind); sig.internal=d.internal
  weak_binding(d,d.internal or (functions:has(d.name) and functions[d.name].internal))
  if functions:has(d.name) then
    local prev=functions[d.name]
    if (not prev.unspecified and not sig.unspecified and ct.function_type(prev) ~= d.kind) or
        prev.ms_abi ~= sig.ms_abi or prev.result ~= sig.result or (d.internal and not prev.internal) then fail('conflicting declaration for ' .. d.name) end
    if definition and prev.defined then fail('multiple definitions of ' .. d.name) end
    sig.internal=prev.internal; sig.defined=prev.defined
    if not definition and sig.unspecified and not prev.unspecified then return prev end
  end
  if definition then sig.defined=true end
  functions[d.name]=sig
  return sig
end

local function save_typedef(d: headers.Declaration)
  if enumerators:has(d.name) or functions:has(d.name) or variables:has(d.name) or
      (aliases:has(d.name) and aliases[d.name] ~= d.kind) then fail('conflicting typedef ' .. d.name) end
  aliases[d.name]=d.kind
end

local function header_declaration()
  local words: headers.Tokens
  local braces,parens: integer=0,0
  local ended,body = false,false
  while #token > 0 do
    if token == ';' and braces == 0 and parens == 0 then
      next_token()
      if not enum_declaration(&words) then
        local d=headers.parse(&words,&aliases,&enumerators)
        if d.kind ~= Kind.Unknown and #d.name > 0 then
          if d.is_typedef then save_typedef(d)
          elseif ct.is_function(d.kind) and not d.internal then register_fn(d,false)
          elseif d.external and not ct.is_function(d.kind) then global_object(d,false,true) end
        end
      end
      words:destroy(); return
    end
    if token == '{' then
      if braces == 0 and ended then body=true end
      braces=braces+1
    elseif token == '}' then braces=braces-1
    elseif token == '(' then parens=parens+1
    elseif token == ')' then
      parens=parens-1
      if braces == 0 and parens == 0 then ended=true end
    end
    words:push(token); next_token()
    if body and braces == 0 then words:destroy(); return end
  end
  fail('unterminated header declaration')
end

local function statement(ret: string): Expr <forwarddecl> end
local function decl_group(top: boolean) <forwarddecl> end

local function starts_decl(): boolean
  return token == '_Static_assert' or token == '__attribute__' or token == '__attribute' or (headers.starts_type(token,&aliases) and locals[token].level == 0) or token == 'static' or
    token == 'extern' or token == 'typedef' or token == 'inline' or token == 'register'
end

local function block(ret: string, nested: boolean): Expr
  local mark=#bindings
  local result: Expr = {kind=Kind.Void}
  if nested then scope=scope+1 end
  while not take('}') do
    if #token == 0 then fail('expected identifier or closing brace') end
    if starts_decl() then decl_group(false); result={kind=Kind.Void}
    else result=statement(ret) end
  end
  if nested then leave_scope(mark); scope=scope-1 end
  return result
end

function statement_expression(): Expr
  local saved_break,saved_continue=break_to,continue_to
  break_to,continue_to='',''
  statement_expression_depth=statement_expression_depth+1
  local result = block(active_ret,true)
  statement_expression_depth=statement_expression_depth-1
  break_to,continue_to=saved_break,saved_continue
  expect(')')
  return result
end

local function test_branch(target: string)
  expect('('); local e=expression(1); expect(')'); branch(e,target,false)
end

local Case = @record{n: integer, target: string}
local Switch = @record{kind: Id, slot: integer, cases: sequence(Case), fallback: string}
local switches: sequence(Switch)
local jump_labels: hashmap(string,string)
local defined_labels: hashmap(string,boolean)

local function jump_label(name: string): string
  if not jump_labels:has(name) then jump_labels[name]=label() end
  return jump_labels[name]
end

local function followed_by(w: string): boolean
  local at,ln,tl,head,path,current=offset,line,token_line,inside_header,source_path,token
  next_token()
  local found=token == w
  offset,line,token_line,inside_header,source_path,token=at,ln,tl,head,path,current
  return found
end

-- Use a PC-relative table for dense switches such as interpreter dispatch.
-- Keep short or sparse switches on the comparison path.
local function dense_dispatch(s: *Switch, fallback: string): boolean
  if #s.cases < 8 then return false end
  local low, high = s.cases[1].n, s.cases[1].n
  for i: usize=2,#s.cases do
    local n = s.cases[i].n
    if n < low then low = n elseif n > high then high = n end
  end
  local span = (@uint64)(high) - (@uint64)(low)
  if span >= 2 * #s.cases or span >= 4096 then return false end
  local targets: sequence(string)
  defer targets:destroy() end
  for i: usize=0,span do targets:push(fallback) end
  for i: usize=1,#s.cases do
    local index = (@uint64)(s.cases[i].n) - (@uint64)(low)
    targets[index+1] = s.cases[i].target
  end
  if low ~= 0 then immediate(low); emit('subq %rax, %rcx') end
  emit('cmpq $' .. tostring(span) .. ', %rcx')
  emit('ja ' .. fallback)
  local table_label = label()
  emit('leaq ' .. table_label .. '(%rip), %rdx')
  emit('movslq (%rdx,%rcx,4), %rax')
  emit('addq %rdx, %rax')
  emit('jmp *%rax')
  emit('.balign 4')
  emit(table_label .. ':')
  for i: usize=1,#targets do emit('.long ' .. targets[i] .. '-' .. table_label) end
  return true
end

local function switch_statement(ret: string)
  expect('(')
  local k=ct.promote(value(expression(1)).kind)
  if not ct.is_integer(k) then fail('switch needs an integer expression') end
  expect(')')
  local s: Switch={kind=k,slot=reserve(k)}
  emit('movq %rax, ' .. address(s.slot)); switches:push(s)
  local dispatch,done=label(),label()
  local outer_break=break_to; break_to=done
  emit('jmp ' .. dispatch)
  statement(ret)
  break_to=outer_break
  s=switches:pop()
  emit('jmp ' .. done); emit(dispatch .. ':')
  emit('movq ' .. address(s.slot) .. ', %rcx')
  if not dense_dispatch(&s, #s.fallback > 0 and s.fallback or done) then
    for i: usize=1,#s.cases do
      immediate(s.cases[i].n); emit('cmpq %rax, %rcx'); emit('je ' .. s.cases[i].target)
    end
    if #s.fallback > 0 then emit('jmp ' .. s.fallback) end
  end
  emit(done .. ':')
  s.cases:destroy()
end

local function case_label(is_default: boolean)
  if #switches == 0 then fail('case outside switch') end
  local s=&switches[#switches]
  local target=label()
  if is_default then
    if #s.fallback > 0 then fail('duplicate default') end
    s.fallback=target
  else
    local words: ce.Tokens
    while #token > 0 and token ~= ':' do words:push(token); next_token() end
    local n,ok=ce.evaluate(&words, &enumerators, &aliases); words:destroy()
    if not ok then fail('expected integer case constant') end
    if s.kind == Kind.Int then n=(@int32)(n) elseif s.kind == Kind.UInt then n=(@uint32)(n) end
    for i: usize=1,#s.cases do if s.cases[i].n == n then fail('duplicate case value') end end
    s.cases:push({n=n,target=target})
  end
  expect(':'); emit(target .. ':')
end

function statement(ret: string): Expr
  local result: Expr = {kind=Kind.Void}
  if take('{') then block(ret,true)
  elseif take('switch') then switch_statement(ret)
  elseif token == 'case' or token == 'default' then
    local is_default=token == 'default'; next_token(); case_label(is_default); statement(ret)
  elseif take('goto') then
    if statement_expression_depth > 0 then fail('goto is unsupported in a GNU statement expression') end
    local name=identifier(); expect(';'); emit('jmp ' .. jump_label(name))
  elseif allowed_name(token) and followed_by(':') then
    if statement_expression_depth > 0 then fail('labels are unsupported in a GNU statement expression') end
    local name=identifier(); expect(':')
    if defined_labels[name] then fail('duplicate label ' .. name) end
    defined_labels[name]=true; emit(jump_label(name) .. ':'); statement(ret)
  elseif take('if') then
    local otherwise=label()
    test_branch(otherwise); statement(ret)
    if take('else') then
      local done=label()
      emit('jmp ' .. done); emit(otherwise .. ':'); statement(ret); emit(done .. ':')
    else emit(otherwise .. ':') end
  elseif token == 'while' or token == 'for' or token == 'do' then
    local loop=token; next_token()
    if loop ~= 'do' then counted_loop=true end
    local saved_break,saved_continue=break_to,continue_to
    local mark=#bindings; scope=scope+1
    local check,start,advance,done=label(),label(),label(),label()
    break_to=done; continue_to=loop == 'for' and advance or check
    if loop == 'do' then
      emit(start .. ':'); statement(ret); expect('while'); emit(check .. ':')
      test_branch(done); expect(';'); emit('jmp ' .. start)
    elseif loop == 'while' then
      emit(check .. ':'); test_branch(done); statement(ret); emit('jmp ' .. check)
    else
      expect('(')
      if starts_decl() then decl_group(false)
      elseif not take(';') then value(expression(1)); expect(';') end
      emit(check .. ':')
      if not take(';') then local e=expression(1); expect(';'); branch(e,done,false) end
      emit('jmp ' .. start); emit(advance .. ':')
      if not take(')') then value(expression(1)); expect(')') end
      emit('jmp ' .. check); emit(start .. ':'); statement(ret); emit('jmp ' .. advance)
    end
    emit(done .. ':'); break_to,continue_to=saved_break,saved_continue
    leave_scope(mark); scope=scope-1
  elseif token == 'break' or token == 'continue' then
    local target=token == 'break' and break_to or continue_to
    if #target == 0 then
      if statement_expression_depth > 0 then fail(token .. ' cannot escape a GNU statement expression') end
      fail('invalid loop jump')
    end
    next_token(); expect(';'); emit('jmp ' .. target)
  elseif take('return') then
    if ct.is_record(function_result) then
      if value(expression(1)).kind ~= function_result then fail('incompatible record return') end
      if indirect_result_slot ~= 0 then
        emit('movq ' .. address(indirect_result_slot) .. ', %rdx'); copy_record(function_result,function_result)
      elseif function_ms then emit('movq %rax, %r11'); load_record_piece(function_result,0)
      else transfer_record_result(function_result, true) end
    elseif function_result ~= Kind.Void then convert(expression(1),function_result,false)
    elseif token ~= ';' then
      if value(expression(1)).kind ~= Kind.Void then fail('unexpected return value') end
    end
    if ct.long_double(function_result) then emit('fldt (%rax)')
    elseif ct.floating(function_result) then xmm_in(function_result,'%xmm0') end
    expect(';'); emit('jmp ' .. ret)
  elseif not take(';') then result=value(expression(1)); expect(';') end
  return result
end

local function compile_function(d: headers.Declaration)
  counted_loop=false
  smallinline.begin_function()
  local sig=register_fn(d,true)
  if sig.ms_abi and ct.long_double(sig.result) then
    fail('unsupported Microsoft x64 long double result')
  end
  slots, va_save_slot, indirect_result_slot = 0, 0, 0
  function_ms, calls_sysv, uses_string_copy = sig.ms_abi, false, false
  local abi: Abi = {ms=sig.ms_abi}
  if not sig.ms_abi and ct.memory_aggregate(sig.result) then
    indirect_result_slot = reserve(ct.pointer(sig.result))
    emit('movq %rdi, ' .. address(indirect_result_slot)); abi.gp = 1
  elseif sig.ms_abi and ms_indirect(sig.result) then
    indirect_result_slot = reserve(ct.pointer(sig.result))
    emit('movq %rcx, ' .. address(indirect_result_slot)); abi.gp = 1
  end
  if sig.variadic and sig.ms_abi then
    for i = 0, 3 do emit('movq ' .. ms_registers[i] .. ', ' .. tostring(16+i*8) .. '(%rbp)') end
  elseif sig.variadic then
    -- SysV register-save area: six GP slots, followed by eight 16-byte SSE slots.
    va_save_slot = reserve(ct.array(Kind.UChar, 176))
    for i = 0, 5 do emit('movq ' .. wide_registers[i] .. ', ' .. address(va_save_slot - i*8)) end
    for i = 0, 7 do
      xmm_out(Kind.Double, '%xmm' .. tostring(i))
      emit('movq %rax, ' .. address(va_save_slot - 48 - i*16))
    end
  end
  for i: usize=1,#d.params do
    local p=d.params[i]
    if #p.name == 0 then fail('parameters must be named in a definition') end
    local v: Variable
    if abi.ms and ms_indirect(p.kind) then
      v = bind_local(p.name,{slot=reserve(ct.pointer(p.kind)),kind=p.kind,indirect=true})
    else v = allocate(p.name,p.kind,false) end
    local incoming: sequence(Placement)
    local stack = abi.stack
    if abi.ms and ct.is_record(p.kind) then incoming:push(place(&abi,Kind.ULong))
    elseif ct.is_record(p.kind) then place_record(&abi, p.kind, &incoming)
    else incoming:push(place(&abi, p.kind)) end
    for j: usize = 1, #incoming do
      local a = incoming[j]
      local dest = address(v.slot - (@integer)(j-1)*8)
      if a.reg == 0 then
        local parameter_offset = stack + a.pad_before
        emit('movq ' .. tostring((abi.ms and 48 or 16) + parameter_offset*8) .. '(%rbp), %rax')
        emit('movq %rax, ' .. dest)
        if ct.long_double(a.kind) then
          emit('movq ' .. tostring((abi.ms and 56 or 24) + parameter_offset*8) .. '(%rbp), %rax')
          emit('movq %rax, ' .. address(v.slot-8))
          stack = stack + a.pad_before + 2
        else stack = stack + a.pad_before + 1 end
      elseif ct.floating(a.kind) then
        xmm_out(a.kind, '%xmm' .. tostring(a.reg-1)); store_memory(a.kind, dest)
      else emit('movq ' .. argument_register(abi.ms,a.reg) .. ', ' .. dest) end
    end
    incoming:destroy()
  end
  va_last = ''
  if sig.variadic then va_fixed, va_last = abi, d.params[#d.params].name end
  function_result=sig.result
  local ret=label()
  active_ret=ret
  block(ret,false)
  active_ret=''
  for name,target in pairs(jump_labels) do
    if not defined_labels[name] then fail('undefined label ' .. name) end
  end
  jump_labels:clear(); defined_labels:clear()
  if #body>0 and body[#body]=='  jmp ' .. ret then
    -- The final explicit return falls directly into the common epilogue.
    body:pop()
  elseif d.name == 'main' then emit('xorl %eax, %eax')
  elseif sig.result ~= Kind.Void then emit('ud2') end
  emit(ret .. ':')
  if depth ~= 0 then fail('unbalanced expression stack') end
  assembly:push('.text')
  if not sig.internal then assembly:push('.globl ' .. d.name) end
  assembly:push('.type ' .. d.name .. ', @function'); assembly:push(d.name .. ':')
  -- RDI/RSI and the full XMM6-XMM15 are nonvolatile for an MS caller.
  -- A nested SysV call may change all of them, even through a function pointer.
  local saved: integer = 0
  if sig.ms_abi and (uses_string_copy or calls_sysv) then
    saved = reserve(ct.array(Kind.UChar, calls_sysv and 176 or 16))
  end
  if sig.internal and not sig.variadic and not sig.ms_abi and abi.stack==0 then
    smallinline.remember(d.name,&body,slots)
  end
  local frameless=saved == 0 and not qualified_storage and leaf.promote(&body,slots)
  if not frameless then
    assembly:push('  pushq %rbp'); assembly:push('  movq %rsp, %rbp')
    if slots > 0 then assembly:push('  subq $' .. tostring(((slots+15)//16)*16) .. ', %rsp') end
  end
  if saved ~= 0 then
    assembly:push('  movq %rdi, ' .. address(saved)); assembly:push('  movq %rsi, ' .. address(saved-8))
    if calls_sysv then
      for i = 6,15 do assembly:push(sse.frame(i,-saved+(i-5)*16,true)) end
    end
  end
  if frameless and counted_loop then affine.emit(&assembly,&body)
  else for i: usize=1,#body do assembly:push(body[i]) end end
  if saved ~= 0 then
    assembly:push('  movq ' .. address(saved) .. ', %rdi'); assembly:push('  movq ' .. address(saved-8) .. ', %rsi')
    if calls_sysv then
      for i = 6,15 do assembly:push(sse.frame(i,-saved+(i-5)*16,false)) end
    end
  end
  if not frameless then assembly:push('  leave') end
  assembly:push('  ret')
  assembly:push('.size ' .. d.name .. ', .-' .. d.name)
  body:clear(); leave_scope(0)
end

local function tag_word(s: string): boolean return s == 'struct' or s == 'union' or s == 'enum' end

function decl_group(top: boolean)
  if token == '_Static_assert' then static_assertion(); return end
  local prefix: headers.Tokens
  repeat
    local words: headers.Tokens
    for i: usize=1,#prefix do words:push(prefix[i]) end
    local nest: integer=0
    while #token > 0 do
      if nest == 0 then
        if token == '=' or token == ',' or token == ';' then break end
        if token == '{' and not (#words >= 1 and tag_word(words[#words])) and
            not (#words >= 2 and tag_word(words[#words-1])) then break end
      end
      if token == '(' or token == '[' or token == '{' then nest=nest+1
      elseif token == ')' or token == ']' or token == '}' then nest=nest-1 end
      if nest < 0 then fail('expected a declaration') end
      words:push(token); next_token()
    end
    if #words == 0 or nest ~= 0 then fail('expected declaration') end
    if token == ';' and enum_declaration(&words) then next_token(); return end
    local d=headers.parse(&words,&aliases,&enumerators)
    if d.kind == Kind.Unknown then fail('invalid or unsupported declaration of ' .. words[#words]) end
    if #d.name == 0 then
      if ct.is_record(d.kind) and take(';') then return end
      fail('expected identifier in declaration')
    end
    if not allowed_name(d.name) then fail('invalid declarator name ' .. d.name) end
    if #prefix == 0 then for i: usize=1,d.spec_count do prefix:push(words[i]) end end
    if d.weak and not top and not (d.external or ct.is_function(d.kind)) then
      fail('weak symbol must have external linkage: ' .. d.name)
    end
    if d.is_typedef then save_typedef(d)
    elseif ct.is_function(d.kind) then
      if top and take('{') then compile_function(d); return end
      register_fn(d,false)
    elseif top then global_object(d,take('='),false)
    else
      local readonly=d.readonly and not ct.is_pointer(d.kind)
      if d.internal then
        local v: Variable={kind=d.kind,symbol=label(),internal=true,readonly=readonly}
        local out=readonly and &rodata or &data
        object_start(v,out)
        if take('=') then v.kind=global_init(d.kind,out)
        else
          if not ct.is_complete(d.kind) then fail('incomplete static object') end
          space(out,ct.size(d.kind))
        end
        out:push('.size ' .. v.symbol .. ', .-' .. v.symbol)
        bind_local(d.name,v)
      elseif d.external then
        if d.weak then global_object(d,false,true) end
        local v: Variable={kind=d.kind,symbol=d.name,readonly=readonly}
        if variables:has(d.name) then
          v=variables[d.name]
          if v.kind ~= d.kind then fail('conflicting declaration for ' .. d.name) end
        end
        bind_local(d.name,v)
      else
        local v=allocate(d.name,d.kind,readonly)
        if take('=') then
          if ct.is_record(d.kind) or ct.is_array(d.kind) then
            zero_local(d.kind, v.slot)
          end
          local_init(d.kind,v.slot)
        end
      end
    end
    words:destroy()
  until not take(',')
  prefix:destroy(); expect(';')
end

local function object_type(name: string): Id
  if locals[name].level > 0 then return locals[name].kind end
  return variables[name].kind
end
-- One translation unit per process. The driver owns temporary-file cleanup
-- for both normal completion and diagnostics from the frontend.
local function compile_unit(path: string, destination: string, roots: *sequence(string), builtin_copy: boolean, object: string): boolean
  optimize_memcpy=builtin_copy
  source_path=path
  header_roots=roots
  local input, reason = io.open(source_path, 'rb')
  if not input then fail(reason) end
  source = input:read('a')
  if not input:close() then fail('could not close input') end
  if #source>0 and memory.scan(source.data,0,#source)~=nilptr then fail('NUL byte in input') end

  ce.object_type = object_type

  local va_fields: ct.Members
  va_fields:push({name='gp_offset', kind=Kind.UInt})
  va_fields:push({name='fp_offset', kind=Kind.UInt})
  va_fields:push({name='overflow_arg_area', kind=ct.pointer(Kind.Void)})
  va_fields:push({name='reg_save_area', kind=ct.pointer(Kind.Void)})
  va_record = ct.tag('struct', '')
  ct.complete(va_record, &va_fields)
  aliases['__builtin_va_list'] = ct.array(va_record, 1)
  aliases['__builtin_ms_va_list'] = ct.pointer(Kind.Char)

  assembly:push('.text')
  next_token()
  while token ~= '' do
    if inside_header then header_declaration()
    elseif take('__asm__') or take('__asm') then
      expect('(')
      if #token == 0 or token:byte(1) ~= 34 then fail('expected a file-scope assembly string') end
      local bytes = strings()
      expect(')'); expect(';')
      local size = #bytes-1
      if memory.scan(&bytes[1],0,size) ~= nilptr then fail('NUL byte in file-scope assembly') end
      -- Keep user assembly distinct from compiler-generated instructions.
      assembly:push('\n' .. (@string){data=&bytes[1],size=size})
      bytes:destroy()
    else decl_group(true) end
  end
  for i: usize=1,#tentative do
    local v=variables[tentative[i]]
    if not v.defined then
      if ct.is_array(v.kind) and ct.count(v.kind) == 0 then v.kind=ct.array(ct.element(v.kind),1) end
      if not ct.is_complete(v.kind) then fail('incomplete tentative definition ' .. v.symbol) end
      local out=v.readonly and &rodata or &data
      object_start(v,out); space(out,ct.size(v.kind)); out:push('.size ' .. v.symbol .. ', .-' .. v.symbol)
    end
  end
  if #data > 0 then
    assembly:push('.data')
    for i: usize = 1, #data do assembly:push(data[i]) end
  end
  if #rodata + #constants > 0 then
    assembly:push('.section .rodata')
    for i: usize = 1, #rodata do assembly:push(rodata[i]) end
    for i: usize = 1, #constants do assembly:push(constants[i]) end
  end
  if #weak_symbols > 0 then
    -- The seed assembler resolves same-section direct calls locally, even
    -- for weak definitions. Its linker also needs an absolute relocation
    -- to resolve the address of an absent weak symbol to zero.
    for i: usize = 1, #assembly do
      local found,replacement = weak_instructions:has_and_get(assembly[i])
      if found then assembly[i] = replacement end
    end
    assembly:push('.section .rodata'); assembly:push('.balign 8')
    for i: usize = 1, #weak_symbols do
      local name = weak_symbols[i]
      assembly:push('.weak ' .. name)
      assembly:push('.Lnecc_weak_' .. name .. ':'); assembly:push('  .quad ' .. name)
    end
  end
  assembly:push('.section .note.GNU-stack,"",@progbits')

  if #object>0 and elf.write(&assembly,object) then return true end
  local output, output_error = io.open(destination, 'wb')
  if not output then fail(output_error) end
  local buffer: stringbuilder
  for i: usize=1,#assembly do
    if not buffer:write(assembly[i], '\n') then fail('out of assembly buffer memory') end
    if #buffer >= 65536 then
      if not output:write(buffer:view()) then fail('could not write assembly') end
      buffer:clear()
    end
  end
  if #buffer>0 and not output:write(buffer:view()) then fail('could not write assembly') end
  if not output:close() then fail('could not close assembly') end
  buffer:destroy()
  return false
end

if #arg >= 3 and arg[1] == '--cc1' then
  local roots: sequence(string)
  for i: usize=4,#arg do roots:push(arg[i]) end
  compile_unit(arg[2],arg[3],&roots,false,'')
else
  driver.run(compile_unit)
end
