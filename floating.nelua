-- Floating constants use the target libc's correctly rounded C conversions.
require 'string'
local ct = require 'ctypes'
local K = ct.Kind
local fp = @record{}
local FloatBits = @union{f: float32, bits: uint32}
local DoubleBits = @union{d: float64, bits: uint64}
-- The supported x86-64 target stores the 80-bit x87 value in the first ten
-- bytes of its 16-byte long-double object (the remaining bytes are padding).
-- Keep these fields separate so callers never route an extended constant
-- through float64 and silently discard its low significand bits.
local ExtendedPadding = @array(byte,6)
local ExtendedParts = @record{significand: uint64, sign_exponent: uint16, padding: ExtendedPadding}
local ExtendedBits = @union{d: clongdouble, parts: ExtendedParts}
local function strtof(s: cstring, rest: *cstring): cfloat <cimport,cinclude '<stdlib.h>'> end
local function strtod(s: cstring, rest: *cstring): cdouble <cimport,cinclude '<stdlib.h>'> end
local function strtold(s: cstring, rest: *cstring): clongdouble <cimport,cinclude '<stdlib.h>'> end

function fp.token(word: string): boolean
  local hex = #word>=2 and word.data[0]==48 and (word.data[1] | 32)==120
  local exponent = hex and 112 or 101
  for i: usize=0,<#word do
    local c=word.data[i]
    if c==46 or (c | 32)==exponent then return true end
  end
  return false
end

function fp.literal(word: string): (integer,ct.Id)
  local last=word:sub(-1):lower()
  local single=last == 'f'
  if last == 'l' then return 0,K.Unknown end
  -- The lexer borrows token text. strtod and strtof need a terminating NUL.
  word=single and word:sub(1,-2) or string.copy(word)
  local start=(@cstring)(word)
  local rest: cstring
  local n: integer
  if single then
    local u: FloatBits; u.f=strtof(start,&rest); n=(@integer)(u.bits)
  else
    local u: DoubleBits; u.d=strtod(start,&rest); n=(@integer)(u.bits)
  end
  local tail = (@*byte)(rest)
  local valid = tail ~= nilptr and rest ~= start and $tail == 0
  word:destroy()
  if not valid then return 0,K.Unknown end
  return n,single and K.Float or K.Double
end

-- Parse a C long-double token using the target's strtold, then expose its
-- exact x87 payload. The `L` suffix is stripped because strtold consumes the
-- numeric spelling and reports the first unparsed character through `rest`.
-- Decimal and hexadecimal inputs are both handled by the C library's correctly
-- rounded conversion, including subnormals and values that differ below the
-- precision of a double.
function fp.literal_long_double(word: string): (uint64,uint16,ct.Id)
  if #word < 2 or word:sub(-1):lower() ~= 'l' then return 0,0,K.Unknown end
  word=word:sub(1,-2)
  local start=(@cstring)(word)
  local rest: cstring
  local u: ExtendedBits
  u.d=strtold(start,&rest)
  local tail=(@*byte)(rest)
  local valid=tail ~= nilptr and rest ~= start and $tail == 0
  local significand=u.parts.significand
  local sign_exponent=u.parts.sign_exponent
  word:destroy()
  if not valid then return 0,0,K.Unknown end
  return significand,sign_exponent,K.LongDouble
end

-- Convert a scalar constant to the destination precision before emitting its bits.
function fp.convert(bits: integer, from: ct.Id, into: ct.Id): integer
  if from == into then return bits end
  local f: FloatBits
  local d: DoubleBits
  if into == K.Float then
    if from == K.Double then d.bits = (@uint64)(bits); f.f = (@float32)(d.d)
    elseif ct.unsigned(from) then f.f = (@float32)((@uint64)(bits))
    else f.f = (@float32)(bits) end
    return (@integer)(f.bits)
  end
  if from == K.Float then f.bits = (@uint32)(bits); d.d = f.f
  elseif ct.unsigned(from) then d.d = (@float64)((@uint64)(bits))
  else d.d = (@float64)(bits) end
  return (@integer)(d.bits)
end

-- Static initializers undergo the conversion to the declared object type.
function fp.constant(bits: integer, significand: uint64, sign_exponent: uint16,
                     from: ct.Id, into: ct.Id): (integer,uint64,uint16)
  if from ~= K.LongDouble and into ~= K.LongDouble then return fp.convert(bits,from,into),0,0 end
  local ext: ExtendedBits
  local f: FloatBits
  local d: DoubleBits
  if from == K.LongDouble then
    ext.parts.significand, ext.parts.sign_exponent = significand, sign_exponent
  elseif from == K.Float then f.bits=(@uint32)(bits); ext.d=f.f
  elseif from == K.Double then d.bits=(@uint64)(bits); ext.d=d.d
  else
    ext.d=(@clongdouble)(bits)
    if ct.unsigned(from) and bits < 0 then ext.d=ext.d+0x1p64 end
  end
  if into == K.LongDouble then return 0,ext.parts.significand,ext.parts.sign_exponent end
  if into == K.Float then f.f=(@float32)(ext.d); return (@integer)(f.bits),0,0 end
  d.d=(@float64)(ext.d)
  return (@integer)(d.bits),0,0
end

return fp
